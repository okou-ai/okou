# Managed by ansible/playbooks/provision-runner.yml.
{
	admin off
	auto_https disable_redirects
}

{{ inventory_hostname }} {
	# TLS-ALPN-01 keeps public ingress on 443; certificate storage is persistent.
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	@runner path_regexp runner ^/ws/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$
	route {
		reverse_proxy @runner unix//var/lib/vm0-runner/wss/{re.runner.1}.sock
		respond 404
	}
}
