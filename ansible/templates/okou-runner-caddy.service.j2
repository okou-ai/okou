# Managed by ansible/playbooks/provision-runner.yml.
[Unit]
Description=Okou Runner Caddy ingress
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
User=okou-runner-caddy
Group=okou-runner-caddy
Environment=XDG_DATA_HOME=/var/lib/okou-runner-caddy
Environment=XDG_CONFIG_HOME=/var/lib/okou-runner-caddy
ExecStart=/usr/local/lib/okou-runner-caddy/{{ runner_caddy_version }}/caddy run --config /etc/okou-runner-caddy/Caddyfile --adapter caddyfile
Restart=on-failure
RestartPreventExitStatus=1
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/okou-runner-caddy
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
