{
  "sourceLanguage": "en",
  "strings": {
    "This chat has reached its limit": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"这段聊天已达到上限"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"這段聊天已達到上限"}},
        "ja": {"stringUnit":{"state":"translated","value":"このチャットは上限に達しました"}},
        "ko": {"stringUnit":{"state":"translated","value":"이 채팅이 한도에 도달했습니다"}},
        "de": {"stringUnit":{"state":"translated","value":"Dieser Chat hat sein Limit erreicht"}},
        "es": {"stringUnit":{"state":"translated","value":"Este chat llegó a su límite"}},
        "fr": {"stringUnit":{"state":"translated","value":"Cette conversation a atteint sa limite"}},
        "hi": {"stringUnit":{"state":"translated","value":"यह चैट अपनी सीमा तक पहुँच गई है"}},
        "id": {"stringUnit":{"state":"translated","value":"Chat ini sudah mencapai batasnya"}},
        "it": {"stringUnit":{"state":"translated","value":"Questa chat ha raggiunto il limite"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Este chat chegou ao limite"}}
      }
    },
    "Start a new chat and include any important details you want to carry over.": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"新建一段聊天，并带上想继续使用的重要信息。"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"開啟新聊天，並帶上想繼續使用的重要資訊。"}},
        "ja": {"stringUnit":{"state":"translated","value":"新しいチャットを始め、引き継ぎたい大切な情報を含めてください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"새 채팅을 시작하고 이어서 필요한 중요한 정보를 포함하세요."}},
        "de": {"stringUnit":{"state":"translated","value":"Starten Sie einen neuen Chat und übernehmen Sie die wichtigen Angaben, die Sie weiter brauchen."}},
        "es": {"stringUnit":{"state":"translated","value":"Inicia un chat nuevo e incluye los detalles importantes que quieras conservar."}},
        "fr": {"stringUnit":{"state":"translated","value":"Démarrez une nouvelle conversation et ajoutez les informations importantes à reprendre."}},
        "hi": {"stringUnit":{"state":"translated","value":"नई चैट शुरू करें और आगे के काम के लिए ज़रूरी जानकारी उसमें जोड़ें।"}},
        "id": {"stringUnit":{"state":"translated","value":"Mulai chat baru dan sertakan informasi penting yang ingin Anda bawa."}},
        "it": {"stringUnit":{"state":"translated","value":"Avvia una nuova chat e aggiungi le informazioni importanti che vuoi conservare."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Inicie um novo chat e inclua as informações importantes que deseja levar adiante."}}
      }
    },
    "This run ran out of space": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"这次运行的存储空间用完了"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"這次執行的儲存空間用完了"}},
        "ja": {"stringUnit":{"state":"translated","value":"この実行の保存容量が足りません"}},
        "ko": {"stringUnit":{"state":"translated","value":"이 실행의 저장 공간이 부족합니다"}},
        "de": {"stringUnit":{"state":"translated","value":"Für diesen Lauf ist kein Speicherplatz mehr frei"}},
        "es": {"stringUnit":{"state":"translated","value":"Este proceso se quedó sin espacio"}},
        "fr": {"stringUnit":{"state":"translated","value":"L’espace de stockage de cette exécution est épuisé"}},
        "hi": {"stringUnit":{"state":"translated","value":"इस रन में जगह खत्म हो गई है"}},
        "id": {"stringUnit":{"state":"translated","value":"Penyimpanan untuk proses ini habis"}},
        "it": {"stringUnit":{"state":"translated","value":"Questa esecuzione ha esaurito lo spazio"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Esta execução ficou sem espaço"}}
      }
    },
    "This run couldn't save more files. Try again to continue.": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"这次运行没法再保存文件。请重试后继续。"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"這次執行無法再儲存檔案。請重試後繼續。"}},
        "ja": {"stringUnit":{"state":"translated","value":"この実行ではこれ以上ファイルを保存できません。再試行して続けてください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"이 실행에서 더 이상 파일을 저장할 수 없습니다. 다시 시도해 계속하세요."}},
        "de": {"stringUnit":{"state":"translated","value":"Dieser Lauf konnte keine weiteren Dateien speichern. Versuchen Sie es erneut."}},
        "es": {"stringUnit":{"state":"translated","value":"Este proceso no pudo guardar más archivos. Vuelve a intentarlo para continuar."}},
        "fr": {"stringUnit":{"state":"translated","value":"Cette exécution n’a pas pu enregistrer d’autres fichiers. Réessayez pour continuer."}},
        "hi": {"stringUnit":{"state":"translated","value":"यह रन और फ़ाइलें सेव नहीं कर सका। जारी रखने के लिए फिर कोशिश करें।"}},
        "id": {"stringUnit":{"state":"translated","value":"Proses ini tidak dapat menyimpan lebih banyak file. Coba lagi untuk melanjutkan."}},
        "it": {"stringUnit":{"state":"translated","value":"Questa esecuzione non ha potuto salvare altri file. Riprova per continuare."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Esta execução não conseguiu salvar mais arquivos. Tente novamente para continuar."}}
      }
    },
    "Time limit reached": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"已达时间上限"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"已達時間上限"}},
        "ja": {"stringUnit":{"state":"translated","value":"時間制限に達しました"}},
        "ko": {"stringUnit":{"state":"translated","value":"시간 제한에 도달했습니다"}},
        "de": {"stringUnit":{"state":"translated","value":"Zeitlimit erreicht"}},
        "es": {"stringUnit":{"state":"translated","value":"Se alcanzó el límite de tiempo"}},
        "fr": {"stringUnit":{"state":"translated","value":"Limite de temps atteinte"}},
        "hi": {"stringUnit":{"state":"translated","value":"समय सीमा पूरी हो गई"}},
        "id": {"stringUnit":{"state":"translated","value":"Batas waktu tercapai"}},
        "it": {"stringUnit":{"state":"translated","value":"Limite di tempo raggiunto"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Limite de tempo atingido"}}
      }
    },
    "You can continue from where this run stopped.": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"可以从上次停止的地方继续。"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"可以從上次停止的地方繼續。"}},
        "ja": {"stringUnit":{"state":"translated","value":"停止したところから続けられます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"중단된 지점부터 계속할 수 있습니다."}},
        "de": {"stringUnit":{"state":"translated","value":"Sie können dort weitermachen, wo dieser Lauf aufgehört hat."}},
        "es": {"stringUnit":{"state":"translated","value":"Puedes continuar desde donde se detuvo este proceso."}},
        "fr": {"stringUnit":{"state":"translated","value":"Vous pouvez reprendre là où cette exécution s’est arrêtée."}},
        "hi": {"stringUnit":{"state":"translated","value":"यह रन जहाँ रुका था, वहाँ से आप आगे बढ़ सकते हैं।"}},
        "id": {"stringUnit":{"state":"translated","value":"Anda dapat melanjutkan dari titik proses ini terhenti."}},
        "it": {"stringUnit":{"state":"translated","value":"Puoi riprendere da dove si è fermata questa esecuzione."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Você pode continuar de onde esta execução parou."}}
      }
    },
    "Your subscription account needs more credit": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"你的订阅账号需要更多额度"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"你的訂閱帳號需要更多額度"}},
        "ja": {"stringUnit":{"state":"translated","value":"サブスクリプションアカウントのクレジットが不足しています"}},
        "ko": {"stringUnit":{"state":"translated","value":"구독 계정에 크레딧이 더 필요합니다"}},
        "de": {"stringUnit":{"state":"translated","value":"Dein Abonnementkonto benötigt mehr Guthaben"}},
        "es": {"stringUnit":{"state":"translated","value":"Tu cuenta de suscripción necesita más saldo"}},
        "fr": {"stringUnit":{"state":"translated","value":"Votre compte d'abonnement a besoin de plus de crédit"}},
        "hi": {"stringUnit":{"state":"translated","value":"आपके सब्सक्रिप्शन खाते में और क्रेडिट चाहिए"}},
        "id": {"stringUnit":{"state":"translated","value":"Akun langganan Anda memerlukan lebih banyak kredit"}},
        "it": {"stringUnit":{"state":"translated","value":"Il tuo account di abbonamento ha bisogno di più credito"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Sua conta de assinatura precisa de mais crédito"}}
      }
    },
    "Check your subscription account's usage or credit balance, then try again.": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"请检查订阅账号的用量或额度余额，然后重试。"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"請檢查訂閱帳號的用量或額度餘額，然後重試。"}},
        "ja": {"stringUnit":{"state":"translated","value":"サブスクリプションアカウントの使用量またはクレジット残高を確認してから、もう一度お試しください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"구독 계정의 사용량 또는 크레딧 잔액을 확인한 후 다시 시도하세요."}},
        "de": {"stringUnit":{"state":"translated","value":"Prüfe die Nutzung oder das Guthaben deines Abonnementkontos und versuche es dann erneut."}},
        "es": {"stringUnit":{"state":"translated","value":"Revisa el uso o el saldo de tu cuenta de suscripción y vuelve a intentarlo."}},
        "fr": {"stringUnit":{"state":"translated","value":"Vérifiez l'utilisation ou le solde de crédit de votre compte d'abonnement, puis réessayez."}},
        "hi": {"stringUnit":{"state":"translated","value":"अपने सब्सक्रिप्शन खाते का उपयोग या क्रेडिट बैलेंस जाँचें, फिर से कोशिश करें।"}},
        "id": {"stringUnit":{"state":"translated","value":"Periksa penggunaan atau saldo kredit akun langganan Anda, lalu coba lagi."}},
        "it": {"stringUnit":{"state":"translated","value":"Controlla l'utilizzo o il saldo del credito del tuo account di abbonamento, poi riprova."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Verifique o uso ou o saldo de créditos da sua conta de assinatura e tente novamente."}}
      }
    },
    "Your subscription sign-in needs updating": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"你的订阅登录需要更新"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"你的訂閱登入需要更新"}},
        "ja": {"stringUnit":{"state":"translated","value":"サブスクリプションのサインインを更新する必要があります"}},
        "ko": {"stringUnit":{"state":"translated","value":"구독 로그인을 업데이트해야 합니다"}},
        "de": {"stringUnit":{"state":"translated","value":"Die Anmeldung deines Abonnements muss aktualisiert werden"}},
        "es": {"stringUnit":{"state":"translated","value":"Hay que actualizar el inicio de sesión de tu suscripción"}},
        "fr": {"stringUnit":{"state":"translated","value":"La connexion de votre abonnement doit être mise à jour"}},
        "hi": {"stringUnit":{"state":"translated","value":"आपके सब्सक्रिप्शन साइन-इन को अपडेट करना होगा"}},
        "id": {"stringUnit":{"state":"translated","value":"Login langganan Anda perlu diperbarui"}},
        "it": {"stringUnit":{"state":"translated","value":"L'accesso al tuo abbonamento deve essere aggiornato"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"O login da sua assinatura precisa ser atualizado"}}
      }
    },
    "Open Settings > Models to reconnect or update your account, then try again.": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"到「设置 > 模型」中重新连接或更新账户，然后再试。"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"到「設定 > 模型」中重新連線或更新帳戶，然後再試。"}},
        "ja": {"stringUnit":{"state":"translated","value":"「設定 > モデル」でアカウントを再接続または更新してから、再試行してください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"'설정 > 모델'에서 계정을 다시 연결하거나 업데이트한 다음 다시 시도하세요."}},
        "de": {"stringUnit":{"state":"translated","value":"Verbinden oder aktualisieren Sie Ihr Konto unter „Einstellungen > Modelle“ und versuchen Sie es erneut."}},
        "es": {"stringUnit":{"state":"translated","value":"Abre Configuración > Modelos para volver a conectar o actualizar tu cuenta y, después, inténtalo de nuevo."}},
        "fr": {"stringUnit":{"state":"translated","value":"Ouvrez « Paramètres > Modèles » pour reconnecter ou mettre à jour votre compte, puis réessayez."}},
        "hi": {"stringUnit":{"state":"translated","value":"सेटिंग्स > मॉडल में खाता फिर से जोड़ें या अपडेट करें, फिर दोबारा कोशिश करें।"}},
        "id": {"stringUnit":{"state":"translated","value":"Buka Setelan > Model untuk menghubungkan ulang atau memperbarui akun, lalu coba lagi."}},
        "it": {"stringUnit":{"state":"translated","value":"Apri Impostazioni > Modelli per ricollegare o aggiornare il tuo account, poi riprova."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Abra Configurações > Modelos para reconectar ou atualizar sua conta e tente novamente."}}
      }
    },
    "Your model connection needs attention": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"模型连接需要更新"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"模型連線需要更新"}},
        "ja": {"stringUnit":{"state":"translated","value":"モデルとの接続を確認してください"}},
        "ko": {"stringUnit":{"state":"translated","value":"모델 연결을 확인해야 합니다"}},
        "de": {"stringUnit":{"state":"translated","value":"Die Modellverbindung muss überprüft werden"}},
        "es": {"stringUnit":{"state":"translated","value":"La conexión con tu modelo necesita atención"}},
        "fr": {"stringUnit":{"state":"translated","value":"La connexion au modèle doit être vérifiée"}},
        "hi": {"stringUnit":{"state":"translated","value":"मॉडल कनेक्शन की जाँच ज़रूरी है"}},
        "id": {"stringUnit":{"state":"translated","value":"Koneksi model Anda perlu diperiksa"}},
        "it": {"stringUnit":{"state":"translated","value":"La connessione al modello va verificata"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Sua conexão com o modelo precisa de atenção"}}
      }
    },
    "Claude terms need acceptance": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"需要接受 Claude 新条款"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"需要接受 Claude 新條款"}},
        "ja": {"stringUnit":{"state":"translated","value":"Claude の規約への同意が必要です"}},
        "ko": {"stringUnit":{"state":"translated","value":"Claude 약관에 동의해야 합니다"}},
        "de": {"stringUnit":{"state":"translated","value":"Die Claude-Bedingungen müssen akzeptiert werden"}},
        "es": {"stringUnit":{"state":"translated","value":"Debes aceptar los términos de Claude"}},
        "fr": {"stringUnit":{"state":"translated","value":"Les conditions de Claude doivent être acceptées"}},
        "hi": {"stringUnit":{"state":"translated","value":"Claude की नई शर्तें स्वीकार करनी होंगी"}},
        "id": {"stringUnit":{"state":"translated","value":"Ketentuan Claude perlu diterima"}},
        "it": {"stringUnit":{"state":"translated","value":"È necessario accettare i termini di Claude"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Os termos do Claude precisam ser aceitos"}}
      }
    },
    "Accept Claude's latest terms, then come back and try again.": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"先在 Claude 接受最新条款，再回来重试。"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"先在 Claude 接受最新條款，再回來重試。"}},
        "ja": {"stringUnit":{"state":"translated","value":"Claude で最新の利用規約に同意してから、こちらで再試行してください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"Claude에서 최신 약관에 동의한 다음 돌아와 다시 시도하세요."}},
        "de": {"stringUnit":{"state":"translated","value":"Akzeptieren Sie die aktuellen Nutzungsbedingungen bei Claude und versuchen Sie es dann erneut."}},
        "es": {"stringUnit":{"state":"translated","value":"Acepta las condiciones más recientes en Claude y vuelve para intentarlo de nuevo."}},
        "fr": {"stringUnit":{"state":"translated","value":"Acceptez les dernières conditions sur Claude, puis revenez et réessayez."}},
        "hi": {"stringUnit":{"state":"translated","value":"Claude में नई शर्तें स्वीकार करें, फिर यहाँ आकर दोबारा कोशिश करें।"}},
        "id": {"stringUnit":{"state":"translated","value":"Setujui ketentuan terbaru di Claude, lalu kembali dan coba lagi."}},
        "it": {"stringUnit":{"state":"translated","value":"Accetta le condizioni più recenti su Claude, poi torna qui e riprova."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Aceite os termos mais recentes no Claude, depois volte e tente novamente."}}
      }
    },
    "This chat is too long": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"这个聊天太长了"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"這個聊天太長了"}},
        "ja": {"stringUnit":{"state":"translated","value":"このチャットは長すぎます"}},
        "ko": {"stringUnit":{"state":"translated","value":"이 채팅이 너무 깁니다"}},
        "de": {"stringUnit":{"state":"translated","value":"Dieser Chat ist zu lang"}},
        "es": {"stringUnit":{"state":"translated","value":"Este chat es demasiado largo"}},
        "fr": {"stringUnit":{"state":"translated","value":"Cette conversation est trop longue"}},
        "hi": {"stringUnit":{"state":"translated","value":"यह चैट बहुत लंबी है"}},
        "id": {"stringUnit":{"state":"translated","value":"Chat ini terlalu panjang"}},
        "it": {"stringUnit":{"state":"translated","value":"Questa chat è troppo lunga"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Este chat é longo demais"}}
      }
    },
    "Your message is too large": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"你的消息太大"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"你的訊息太大"}},
        "ja": {"stringUnit":{"state":"translated","value":"メッセージが大きすぎます"}},
        "ko": {"stringUnit":{"state":"translated","value":"메시지가 너무 큽니다"}},
        "de": {"stringUnit":{"state":"translated","value":"Ihre Nachricht ist zu groß"}},
        "es": {"stringUnit":{"state":"translated","value":"Tu mensaje es demasiado grande"}},
        "fr": {"stringUnit":{"state":"translated","value":"Votre message est trop volumineux"}},
        "hi": {"stringUnit":{"state":"translated","value":"आपका संदेश बहुत बड़ा है"}},
        "id": {"stringUnit":{"state":"translated","value":"Pesan Anda terlalu besar"}},
        "it": {"stringUnit":{"state":"translated","value":"Il messaggio è troppo grande"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Sua mensagem é grande demais"}}
      }
    },
    "Shorten your message and send it again.": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"请缩短消息内容后重新发送。"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"請縮短訊息內容後重新傳送。"}},
        "ja": {"stringUnit":{"state":"translated","value":"メッセージを短くして、もう一度送信してください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"메시지를 줄인 다음 다시 보내세요."}},
        "de": {"stringUnit":{"state":"translated","value":"Kürzen Sie Ihre Nachricht und senden Sie sie erneut."}},
        "es": {"stringUnit":{"state":"translated","value":"Acorta el mensaje y vuelve a enviarlo."}},
        "fr": {"stringUnit":{"state":"translated","value":"Raccourcissez votre message et renvoyez-le."}},
        "hi": {"stringUnit":{"state":"translated","value":"अपना संदेश छोटा करके फिर भेजें।"}},
        "id": {"stringUnit":{"state":"translated","value":"Persingkat pesan Anda lalu kirim lagi."}},
        "it": {"stringUnit":{"state":"translated","value":"Accorcia il messaggio e invialo di nuovo."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Encurte sua mensagem e envie de novo."}}
      }
    },
    "The response reached its length limit": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"回复达到了长度上限"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"回覆達到了長度上限"}},
        "ja": {"stringUnit":{"state":"translated","value":"応答が長さの上限に達しました"}},
        "ko": {"stringUnit":{"state":"translated","value":"응답이 길이 제한에 도달했습니다"}},
        "de": {"stringUnit":{"state":"translated","value":"Die Antwort hat ihre Längenbegrenzung erreicht"}},
        "es": {"stringUnit":{"state":"translated","value":"La respuesta alcanzó el límite de longitud"}},
        "fr": {"stringUnit":{"state":"translated","value":"La réponse a atteint sa limite de longueur"}},
        "hi": {"stringUnit":{"state":"translated","value":"जवाब लंबाई की सीमा तक पहुँच गया"}},
        "id": {"stringUnit":{"state":"translated","value":"Jawaban mencapai batas panjang"}},
        "it": {"stringUnit":{"state":"translated","value":"La risposta ha raggiunto il limite di lunghezza"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"A resposta chegou ao limite de tamanho"}}
      }
    },
    "The response stopped before it finished. Continue to pick up from there.": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"回复还没完成就停止了。点击“继续”可以接着生成。"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"回覆還沒完成就停止了。點選「繼續」可以接著生成。"}},
        "ja": {"stringUnit":{"state":"translated","value":"応答が完了する前に止まりました。「続ける」を選ぶと続きから生成できます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"응답이 완료되기 전에 멈췄습니다. '계속'을 눌러 이어서 생성하세요."}},
        "de": {"stringUnit":{"state":"translated","value":"Die Antwort wurde vorzeitig beendet. Mit „Fortfahren“ können Sie dort weitermachen."}},
        "es": {"stringUnit":{"state":"translated","value":"La respuesta se detuvo antes de terminar. Pulsa «Continuar» para retomarla."}},
        "fr": {"stringUnit":{"state":"translated","value":"La réponse s’est arrêtée avant la fin. Choisissez « Continuer » pour reprendre."}},
        "hi": {"stringUnit":{"state":"translated","value":"जवाब पूरा होने से पहले रुक गया। वहीं से आगे बढ़ने के लिए 'जारी रखें' चुनें।"}},
        "id": {"stringUnit":{"state":"translated","value":"Jawaban berhenti sebelum selesai. Pilih Lanjutkan untuk meneruskannya."}},
        "it": {"stringUnit":{"state":"translated","value":"La risposta si è fermata prima di terminare. Scegli «Continua» per riprendere."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"A resposta parou antes de terminar. Selecione Continuar para retomar."}}
      }
    },
    "Too many model requests right now": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"当前模型请求过多"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"目前模型請求過多"}},
        "ja": {"stringUnit":{"state":"translated","value":"モデルへのリクエストが多すぎます"}},
        "ko": {"stringUnit":{"state":"translated","value":"지금은 모델 요청이 너무 많습니다"}},
        "de": {"stringUnit":{"state":"translated","value":"Gerade gibt es zu viele Modellanfragen"}},
        "es": {"stringUnit":{"state":"translated","value":"Hay demasiadas solicitudes al modelo ahora mismo"}},
        "fr": {"stringUnit":{"state":"translated","value":"Il y a trop de demandes au modèle en ce moment"}},
        "hi": {"stringUnit":{"state":"translated","value":"अभी मॉडल के लिए बहुत ज़्यादा अनुरोध हैं"}},
        "id": {"stringUnit":{"state":"translated","value":"Saat ini ada terlalu banyak permintaan model"}},
        "it": {"stringUnit":{"state":"translated","value":"Ci sono troppe richieste al modello in questo momento"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Há solicitações demais ao modelo no momento"}}
      }
    },
    "Try again in a moment, or choose another model to keep working.": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"可以稍等片刻再试，或换个模型继续。"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"可以稍等片刻再試，或換個模型繼續。"}},
        "ja": {"stringUnit":{"state":"translated","value":"少し待ってから再試行するか、別のモデルで続けてください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"잠시 후 다시 시도하거나 다른 모델로 작업을 계속하세요."}},
        "de": {"stringUnit":{"state":"translated","value":"Versuchen Sie es gleich noch einmal oder arbeiten Sie mit einem anderen Modell weiter."}},
        "es": {"stringUnit":{"state":"translated","value":"Vuelve a intentarlo en un momento o elige otro modelo para seguir trabajando."}},
        "fr": {"stringUnit":{"state":"translated","value":"Réessayez dans un instant ou choisissez un autre modèle pour continuer."}},
        "hi": {"stringUnit":{"state":"translated","value":"कुछ देर बाद फिर कोशिश करें, या काम जारी रखने के लिए दूसरा मॉडल चुनें।"}},
        "id": {"stringUnit":{"state":"translated","value":"Coba lagi sebentar, atau pilih model lain agar pekerjaan tetap berjalan."}},
        "it": {"stringUnit":{"state":"translated","value":"Riprova tra poco oppure scegli un altro modello per continuare a lavorare."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Tente novamente em instantes ou escolha outro modelo para continuar."}}
      }
    },
    "This model is busy right now": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"这个模型现在很忙"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"這個模型現在很忙"}},
        "ja": {"stringUnit":{"state":"translated","value":"このモデルは現在混雑しています"}},
        "ko": {"stringUnit":{"state":"translated","value":"이 모델은 지금 혼잡합니다"}},
        "de": {"stringUnit":{"state":"translated","value":"Dieses Modell ist gerade ausgelastet"}},
        "es": {"stringUnit":{"state":"translated","value":"Este modelo está ocupado ahora mismo"}},
        "fr": {"stringUnit":{"state":"translated","value":"Ce modèle est saturé pour le moment"}},
        "hi": {"stringUnit":{"state":"translated","value":"यह मॉडल अभी व्यस्त है"}},
        "id": {"stringUnit":{"state":"translated","value":"Model ini sedang sibuk"}},
        "it": {"stringUnit":{"state":"translated","value":"Questo modello è occupato in questo momento"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Este modelo está ocupado no momento"}}
      }
    },
    "The model response timed out": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"模型响应已超时"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"模型回應已逾時"}},
        "ja": {"stringUnit":{"state":"translated","value":"モデルの応答がタイムアウトしました"}},
        "ko": {"stringUnit":{"state":"translated","value":"모델 응답 시간이 초과되었습니다"}},
        "de": {"stringUnit":{"state":"translated","value":"Die Modellantwort ist abgelaufen"}},
        "es": {"stringUnit":{"state":"translated","value":"La respuesta del modelo agotó el tiempo"}},
        "fr": {"stringUnit":{"state":"translated","value":"La réponse du modèle a expiré"}},
        "hi": {"stringUnit":{"state":"translated","value":"मॉडल प्रतिक्रिया का समय समाप्त हो गया"}},
        "id": {"stringUnit":{"state":"translated","value":"Respons model kehabisan waktu"}},
        "it": {"stringUnit":{"state":"translated","value":"La risposta del modello è scaduta"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"A resposta do modelo expirou"}}
      }
    },
    "The model didn't start in time": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"模型等待启动的时间过长"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"模型等待啟動的時間過長"}},
        "ja": {"stringUnit":{"state":"translated","value":"モデルの起動が間に合いませんでした"}},
        "ko": {"stringUnit":{"state":"translated","value":"모델이 제때 시작되지 않았습니다"}},
        "de": {"stringUnit":{"state":"translated","value":"Das Modell wurde nicht rechtzeitig gestartet"}},
        "es": {"stringUnit":{"state":"translated","value":"El modelo no se inició a tiempo"}},
        "fr": {"stringUnit":{"state":"translated","value":"Le modèle n’a pas démarré à temps"}},
        "hi": {"stringUnit":{"state":"translated","value":"मॉडल समय पर शुरू नहीं हुआ"}},
        "id": {"stringUnit":{"state":"translated","value":"Model tidak mulai tepat waktu"}},
        "it": {"stringUnit":{"state":"translated","value":"Il modello non si è avviato in tempo"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"O modelo não iniciou a tempo"}}
      }
    },
    "Codex access is temporarily unavailable": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"Codex 暂时无法访问"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"Codex 暫時無法存取"}},
        "ja": {"stringUnit":{"state":"translated","value":"Codex へのアクセスは一時的に利用できません"}},
        "ko": {"stringUnit":{"state":"translated","value":"Codex 액세스를 일시적으로 사용할 수 없습니다"}},
        "de": {"stringUnit":{"state":"translated","value":"Codex-Zugriff ist vorübergehend nicht verfügbar"}},
        "es": {"stringUnit":{"state":"translated","value":"El acceso a Codex no está disponible temporalmente"}},
        "fr": {"stringUnit":{"state":"translated","value":"L’accès à Codex est temporairement indisponible"}},
        "hi": {"stringUnit":{"state":"translated","value":"Codex एक्सेस अस्थायी रूप से उपलब्ध नहीं है"}},
        "id": {"stringUnit":{"state":"translated","value":"Akses Codex sementara tidak tersedia"}},
        "it": {"stringUnit":{"state":"translated","value":"L’accesso a Codex non è temporaneamente disponibile"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"O acesso ao Codex está temporariamente indisponível"}}
      }
    },
    "Try again in a little while. You can keep this chat open.": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"稍后再试，仍可在这段聊天中继续。"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"稍後再試，仍可在這段聊天中繼續。"}},
        "ja": {"stringUnit":{"state":"translated","value":"少し時間をおいて再試行してください。このチャットは開いたままにできます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"잠시 후 다시 시도하세요. 이 채팅은 그대로 열어 둘 수 있습니다."}},
        "de": {"stringUnit":{"state":"translated","value":"Versuchen Sie es in Kürze erneut. Sie können diesen Chat geöffnet lassen."}},
        "es": {"stringUnit":{"state":"translated","value":"Vuelve a intentarlo dentro de un momento. Puedes dejar este chat abierto."}},
        "fr": {"stringUnit":{"state":"translated","value":"Réessayez dans quelques instants. Vous pouvez laisser cette conversation ouverte."}},
        "hi": {"stringUnit":{"state":"translated","value":"थोड़ी देर बाद फिर कोशिश करें। आप इस चैट को खुला रख सकते हैं।"}},
        "id": {"stringUnit":{"state":"translated","value":"Coba lagi sebentar lagi. Chat ini bisa tetap terbuka."}},
        "it": {"stringUnit":{"state":"translated","value":"Riprova tra poco. Puoi lasciare aperta questa chat."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Tente novamente daqui a pouco. Você pode manter este chat aberto."}}
      }
    },
    "The model provider had a temporary error": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"模型服务商暂时出错"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"模型服務商暫時出錯"}},
        "ja": {"stringUnit":{"state":"translated","value":"モデルプロバイダーで一時的なエラーが発生しました"}},
        "ko": {"stringUnit":{"state":"translated","value":"모델 제공자에 일시적인 오류가 발생했습니다"}},
        "de": {"stringUnit":{"state":"translated","value":"Beim Modellanbieter ist ein vorübergehender Fehler aufgetreten"}},
        "es": {"stringUnit":{"state":"translated","value":"El proveedor de modelos tuvo un error temporal"}},
        "fr": {"stringUnit":{"state":"translated","value":"Le fournisseur de modèles a rencontré une erreur temporaire"}},
        "hi": {"stringUnit":{"state":"translated","value":"मॉडल प्रदाता में अस्थायी त्रुटि हुई"}},
        "id": {"stringUnit":{"state":"translated","value":"Penyedia model mengalami kesalahan sementara"}},
        "it": {"stringUnit":{"state":"translated","value":"Il provider di modelli ha avuto un errore temporaneo"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"O provedor de modelos teve um erro temporário"}}
      }
    },
    "The response was interrupted": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"回复中途断开了"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"回覆中途斷開了"}},
        "ja": {"stringUnit":{"state":"translated","value":"応答が途中で途切れました"}},
        "ko": {"stringUnit":{"state":"translated","value":"응답이 중간에 끊겼습니다"}},
        "de": {"stringUnit":{"state":"translated","value":"Die Antwort wurde unterbrochen"}},
        "es": {"stringUnit":{"state":"translated","value":"La respuesta se interrumpió"}},
        "fr": {"stringUnit":{"state":"translated","value":"La réponse a été interrompue"}},
        "hi": {"stringUnit":{"state":"translated","value":"जवाब बीच में रुक गया"}},
        "id": {"stringUnit":{"state":"translated","value":"Jawaban terputus"}},
        "it": {"stringUnit":{"state":"translated","value":"La risposta si è interrotta"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"A resposta foi interrompida"}}
      }
    },
    "The model couldn't help with this request": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"模型无法处理这个请求"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"模型無法處理這個請求"}},
        "ja": {"stringUnit":{"state":"translated","value":"モデルはこのリクエストに対応できませんでした"}},
        "ko": {"stringUnit":{"state":"translated","value":"모델이 이 요청을 처리할 수 없습니다"}},
        "de": {"stringUnit":{"state":"translated","value":"Das Modell konnte bei dieser Anfrage nicht helfen"}},
        "es": {"stringUnit":{"state":"translated","value":"El modelo no pudo ayudar con esta solicitud"}},
        "fr": {"stringUnit":{"state":"translated","value":"Le modèle n’a pas pu répondre à cette demande"}},
        "hi": {"stringUnit":{"state":"translated","value":"मॉडल इस अनुरोध में मदद नहीं कर सका"}},
        "id": {"stringUnit":{"state":"translated","value":"Model tidak dapat membantu permintaan ini"}},
        "it": {"stringUnit":{"state":"translated","value":"Il modello non può aiutarti con questa richiesta"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"O modelo não pôde ajudar com esta solicitação"}}
      }
    },
    "This request didn't pass the model's safety checks. Try rephrasing it or choosing another model.": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"这个请求未通过模型的安全检查。可以换个说法，或选择其他模型。"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"這個請求未通過模型的安全檢查。可以換個說法，或選擇其他模型。"}},
        "ja": {"stringUnit":{"state":"translated","value":"このリクエストはモデルの安全基準を満たしませんでした。表現を変えるか、別のモデルを選んでください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"이 요청은 모델의 안전 기준을 통과하지 못했습니다. 표현을 바꾸거나 다른 모델을 선택해 보세요."}},
        "de": {"stringUnit":{"state":"translated","value":"Die Anfrage entsprach nicht den Sicherheitsregeln des Modells. Formulieren Sie sie anders oder wählen Sie ein anderes Modell."}},
        "es": {"stringUnit":{"state":"translated","value":"La solicitud no superó las comprobaciones de seguridad del modelo. Prueba a reformularla o a elegir otro modelo."}},
        "fr": {"stringUnit":{"state":"translated","value":"Cette demande n’a pas passé les contrôles de sécurité du modèle. Reformulez-la ou choisissez un autre modèle."}},
        "hi": {"stringUnit":{"state":"translated","value":"यह अनुरोध मॉडल की सुरक्षा जाँच में पास नहीं हुआ। इसे अलग तरह से लिखें या दूसरा मॉडल चुनें।"}},
        "id": {"stringUnit":{"state":"translated","value":"Permintaan ini tidak lolos pemeriksaan keamanan model. Coba ubah kalimatnya atau pilih model lain."}},
        "it": {"stringUnit":{"state":"translated","value":"La richiesta non ha superato i controlli di sicurezza del modello. Prova a riformularla o scegli un altro modello."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Esta solicitação não passou pelas verificações de segurança do modelo. Tente reformulá-la ou escolher outro modelo."}}
      }
    },
    "Reconnect your model account": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"重新连接模型账户"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"重新連接模型帳戶"}},
        "ja": {"stringUnit":{"state":"translated","value":"モデルアカウントを再接続"}},
        "ko": {"stringUnit":{"state":"translated","value":"모델 계정을 다시 연결하세요"}},
        "de": {"stringUnit":{"state":"translated","value":"Modellkonto erneut verbinden"}},
        "es": {"stringUnit":{"state":"translated","value":"Vuelve a conectar tu cuenta de modelo"}},
        "fr": {"stringUnit":{"state":"translated","value":"Reconnectez votre compte de modèle"}},
        "hi": {"stringUnit":{"state":"translated","value":"अपने मॉडल खाते को फिर से कनेक्ट करें"}},
        "id": {"stringUnit":{"state":"translated","value":"Hubungkan kembali akun model Anda"}},
        "it": {"stringUnit":{"state":"translated","value":"Ricollega il tuo account modello"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Reconecte sua conta de modelo"}}
      }
    },
    "Selected model isn't available": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"所选模型不可用"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"所選模型不可用"}},
        "ja": {"stringUnit":{"state":"translated","value":"選択したモデルは利用できません"}},
        "ko": {"stringUnit":{"state":"translated","value":"선택한 모델을 사용할 수 없습니다"}},
        "de": {"stringUnit":{"state":"translated","value":"Ausgewähltes Modell ist nicht verfügbar"}},
        "es": {"stringUnit":{"state":"translated","value":"El modelo seleccionado no está disponible"}},
        "fr": {"stringUnit":{"state":"translated","value":"Le modèle sélectionné n’est pas disponible"}},
        "hi": {"stringUnit":{"state":"translated","value":"चुना गया मॉडल उपलब्ध नहीं है"}},
        "id": {"stringUnit":{"state":"translated","value":"Model yang dipilih tidak tersedia"}},
        "it": {"stringUnit":{"state":"translated","value":"Il modello selezionato non è disponibile"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"O modelo selecionado não está disponível"}}
      }
    },
    "Choose a different model that works with your provider account.": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"请选择当前服务商账户支持的其他模型。"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"請選擇目前服務商帳戶支援的其他模型。"}},
        "ja": {"stringUnit":{"state":"translated","value":"このプロバイダーアカウントで使える別のモデルを選んでください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"현재 제공자 계정에서 사용할 수 있는 다른 모델을 선택하세요."}},
        "de": {"stringUnit":{"state":"translated","value":"Wählen Sie ein anderes Modell, das mit Ihrem Anbieterkonto funktioniert."}},
        "es": {"stringUnit":{"state":"translated","value":"Elige otro modelo que funcione con tu cuenta del proveedor."}},
        "fr": {"stringUnit":{"state":"translated","value":"Choisissez un autre modèle compatible avec votre compte fournisseur."}},
        "hi": {"stringUnit":{"state":"translated","value":"ऐसा दूसरा मॉडल चुनें जो आपके प्रदाता खाते के साथ काम करता हो।"}},
        "id": {"stringUnit":{"state":"translated","value":"Pilih model lain yang dapat digunakan dengan akun penyedia Anda."}},
        "it": {"stringUnit":{"state":"translated","value":"Scegli un altro modello compatibile con il tuo account provider."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Escolha outro modelo compatível com sua conta no provedor."}}
      }
    },
    "Model provider limit reached": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"模型服务商用量已达上限"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"模型服務商用量已達上限"}},
        "ja": {"stringUnit":{"state":"translated","value":"モデルプロバイダーの上限に達しました"}},
        "ko": {"stringUnit":{"state":"translated","value":"모델 제공자 한도에 도달했습니다"}},
        "de": {"stringUnit":{"state":"translated","value":"Limit des Modellanbieters erreicht"}},
        "es": {"stringUnit":{"state":"translated","value":"Se alcanzó el límite del proveedor de modelos"}},
        "fr": {"stringUnit":{"state":"translated","value":"Limite du fournisseur de modèles atteinte"}},
        "hi": {"stringUnit":{"state":"translated","value":"मॉडल प्रदाता की सीमा पूरी हो गई"}},
        "id": {"stringUnit":{"state":"translated","value":"Batas penyedia model tercapai"}},
        "it": {"stringUnit":{"state":"translated","value":"Limite del provider di modelli raggiunto"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Limite do provedor de modelos atingido"}}
      }
    },
    "You can continue when your usage limit resets, or switch models now.": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"等用量额度重置后可以继续，也可以现在换个模型。"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"等用量額度重置後可以繼續，也可以現在換個模型。"}},
        "ja": {"stringUnit":{"state":"translated","value":"使用制限がリセットされた後に続行するか、今すぐ別のモデルに切り替えられます。"}},
        "ko": {"stringUnit":{"state":"translated","value":"사용량 한도가 재설정되면 계속하거나 지금 다른 모델로 전환할 수 있습니다."}},
        "de": {"stringUnit":{"state":"translated","value":"Sie können fortfahren, wenn Ihr Nutzungslimit zurückgesetzt wird, oder jetzt das Modell wechseln."}},
        "es": {"stringUnit":{"state":"translated","value":"Puedes continuar cuando se restablezca tu límite de uso o cambiar de modelo ahora."}},
        "fr": {"stringUnit":{"state":"translated","value":"Vous pourrez continuer lorsque votre limite d'utilisation sera réinitialisée, ou changer de modèle maintenant."}},
        "hi": {"stringUnit":{"state":"translated","value":"उपयोग सीमा रीसेट होने पर आप जारी रख सकते हैं, या अभी मॉडल बदलें।"}},
        "id": {"stringUnit":{"state":"translated","value":"Anda dapat melanjutkan saat batas penggunaan direset, atau ganti model sekarang."}},
        "it": {"stringUnit":{"state":"translated","value":"Puoi continuare quando il limite di utilizzo viene reimpostato oppure cambiare modello ora."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Você pode continuar quando o limite de uso for redefinido ou trocar de modelo agora."}}
      }
    },
    "This run couldn't finish": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"这次运行没能完成"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"這次執行沒能完成"}},
        "ja": {"stringUnit":{"state":"translated","value":"この実行を完了できませんでした"}},
        "ko": {"stringUnit":{"state":"translated","value":"이 실행을 완료하지 못했습니다"}},
        "de": {"stringUnit":{"state":"translated","value":"Dieser Lauf konnte nicht abgeschlossen werden"}},
        "es": {"stringUnit":{"state":"translated","value":"No se pudo completar esta ejecución"}},
        "fr": {"stringUnit":{"state":"translated","value":"Cette exécution n’a pas pu se terminer"}},
        "hi": {"stringUnit":{"state":"translated","value":"यह रन पूरा नहीं हो सका"}},
        "id": {"stringUnit":{"state":"translated","value":"Proses ini tidak dapat diselesaikan"}},
        "it": {"stringUnit":{"state":"translated","value":"Non è stato possibile completare questa esecuzione"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Não foi possível concluir esta execução"}}
      }
    },
    "Open the chat on the Okou website for details.": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"在 Okou 网站打开此聊天以查看详情。"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"在 Okou 網站開啟此聊天以查看詳細資訊。"}},
        "ja": {"stringUnit":{"state":"translated","value":"詳細は Okou のウェブサイトでこのチャットを開いて確認してください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"자세한 내용은 Okou 웹사이트에서 이 채팅을 여세요."}},
        "de": {"stringUnit":{"state":"translated","value":"Öffne den Chat auf der Okou-Website, um Details zu sehen."}},
        "es": {"stringUnit":{"state":"translated","value":"Abre el chat en el sitio web de Okou para ver los detalles."}},
        "fr": {"stringUnit":{"state":"translated","value":"Ouvrez le chat sur le site d’Okou pour plus de détails."}},
        "hi": {"stringUnit":{"state":"translated","value":"विवरण के लिए Okou वेबसाइट पर यह चैट खोलें।"}},
        "id": {"stringUnit":{"state":"translated","value":"Buka chat di situs web Okou untuk melihat detailnya."}},
        "it": {"stringUnit":{"state":"translated","value":"Apri la chat sul sito web di Okou per i dettagli."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Abra o chat no site do Okou para ver os detalhes."}}
      }
    },
    "Oops, something went wrong.": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"出了点问题。"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"出了點問題。"}},
        "ja": {"stringUnit":{"state":"translated","value":"エラーが発生しました。"}},
        "ko": {"stringUnit":{"state":"translated","value":"오류가 발생했습니다."}},
        "de": {"stringUnit":{"state":"translated","value":"Ein Fehler ist aufgetreten."}},
        "es": {"stringUnit":{"state":"translated","value":"Se ha producido un error."}},
        "fr": {"stringUnit":{"state":"translated","value":"Une erreur s’est produite."}},
        "hi": {"stringUnit":{"state":"translated","value":"कुछ गड़बड़ हो गई।"}},
        "id": {"stringUnit":{"state":"translated","value":"Terjadi kesalahan."}},
        "it": {"stringUnit":{"state":"translated","value":"Si è verificato un errore."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Ocorreu um erro."}}
      }
    },
    "Out of credits": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"额度不足"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"額度不足"}},
        "ja": {"stringUnit":{"state":"translated","value":"クレジットが不足しています"}},
        "ko": {"stringUnit":{"state":"translated","value":"크레딧이 부족합니다"}},
        "de": {"stringUnit":{"state":"translated","value":"Keine Credits mehr"}},
        "es": {"stringUnit":{"state":"translated","value":"Sin créditos"}},
        "fr": {"stringUnit":{"state":"translated","value":"Crédits épuisés"}},
        "hi": {"stringUnit":{"state":"translated","value":"क्रेडिट समाप्त"}},
        "id": {"stringUnit":{"state":"translated","value":"Kredit habis"}},
        "it": {"stringUnit":{"state":"translated","value":"Crediti esauriti"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Sem créditos"}}
      }
    },
    "Check your workspace's plan or credit balance.": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"检查工作区的套餐或剩余额度。"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"檢查工作區的方案或剩餘額度。"}},
        "ja": {"stringUnit":{"state":"translated","value":"ワークスペースのプランまたはクレジット残高を確認してください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"워크스페이스 요금제 또는 크레딧 잔액을 확인하세요."}},
        "de": {"stringUnit":{"state":"translated","value":"Prüfe den Tarif oder das Credit-Guthaben deines Workspace."}},
        "es": {"stringUnit":{"state":"translated","value":"Revisa el plan o el saldo de créditos de tu espacio de trabajo."}},
        "fr": {"stringUnit":{"state":"translated","value":"Vérifiez le forfait ou le solde de crédits de votre espace de travail."}},
        "hi": {"stringUnit":{"state":"translated","value":"अपने वर्कस्पेस का प्लान या क्रेडिट बैलेंस जाँचें।"}},
        "id": {"stringUnit":{"state":"translated","value":"Periksa paket atau saldo kredit ruang kerja Anda."}},
        "it": {"stringUnit":{"state":"translated","value":"Controlla il piano o il saldo dei crediti del tuo spazio di lavoro."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Verifique o plano ou o saldo de créditos do seu espaço de trabalho."}}
      }
    },
    "Claude account verification required": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"Claude 账号需要验证"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"Claude 帳號需要驗證"}},
        "ja": {"stringUnit":{"state":"translated","value":"Claude アカウントの確認が必要です"}},
        "ko": {"stringUnit":{"state":"translated","value":"Claude 계정 인증이 필요합니다"}},
        "de": {"stringUnit":{"state":"translated","value":"Claude-Kontoverifizierung erforderlich"}},
        "es": {"stringUnit":{"state":"translated","value":"Se requiere verificar la cuenta de Claude"}},
        "fr": {"stringUnit":{"state":"translated","value":"Vérification du compte Claude requise"}},
        "hi": {"stringUnit":{"state":"translated","value":"Claude खाते का सत्यापन ज़रूरी है"}},
        "id": {"stringUnit":{"state":"translated","value":"Verifikasi akun Claude diperlukan"}},
        "it": {"stringUnit":{"state":"translated","value":"È richiesta la verifica dell'account Claude"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"É necessário verificar a conta do Claude"}}
      }
    },
    "Your Claude account can't receive replies right now. Check the Anthropic Verification Portal for the next step.": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"你的 Claude 账号目前无法接收回复。请前往 Anthropic 验证门户查看下一步操作。"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"你的 Claude 帳號目前無法接收回覆。請前往 Anthropic 驗證入口查看下一步操作。"}},
        "ja": {"stringUnit":{"state":"translated","value":"現在、Claude アカウントで返信を受け取れません。Anthropic Verification Portal で次の手順を確認してください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"현재 Claude 계정에서 응답을 받을 수 없습니다. Anthropic Verification Portal에서 다음 단계를 확인하세요."}},
        "de": {"stringUnit":{"state":"translated","value":"Ihr Claude-Konto kann derzeit keine Antworten empfangen. Den nächsten Schritt finden Sie im Anthropic Verification Portal."}},
        "es": {"stringUnit":{"state":"translated","value":"Tu cuenta de Claude no puede recibir respuestas en este momento. Consulta el siguiente paso en el portal de verificación de Anthropic."}},
        "fr": {"stringUnit":{"state":"translated","value":"Votre compte Claude ne peut pas recevoir de réponses pour le moment. Consultez le portail de vérification Anthropic pour connaître la prochaine étape."}},
        "hi": {"stringUnit":{"state":"translated","value":"आपका Claude खाता अभी जवाब प्राप्त नहीं कर सकता। अगले कदम के लिए Anthropic सत्यापन पोर्टल देखें।"}},
        "id": {"stringUnit":{"state":"translated","value":"Akun Claude Anda saat ini tidak dapat menerima balasan. Periksa langkah berikutnya di Portal Verifikasi Anthropic."}},
        "it": {"stringUnit":{"state":"translated","value":"Al momento il tuo account Claude non può ricevere risposte. Consulta il portale di verifica Anthropic per conoscere il prossimo passaggio."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Sua conta do Claude não pode receber respostas no momento. Consulte o portal de verificação da Anthropic para saber o próximo passo."}}
      }
    },
    "The model provider returned an error": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"模型服务商返回错误"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"模型服務商傳回錯誤"}},
        "ja": {"stringUnit":{"state":"translated","value":"モデル提供元からエラーが返されました"}},
        "ko": {"stringUnit":{"state":"translated","value":"모델 제공업체에서 오류를 반환했습니다"}},
        "de": {"stringUnit":{"state":"translated","value":"Der Modellanbieter hat einen Fehler zurückgegeben"}},
        "es": {"stringUnit":{"state":"translated","value":"El proveedor del modelo ha devuelto un error"}},
        "fr": {"stringUnit":{"state":"translated","value":"Le fournisseur du modèle a renvoyé une erreur"}},
        "hi": {"stringUnit":{"state":"translated","value":"मॉडल प्रदाता ने एक त्रुटि लौटाई"}},
        "id": {"stringUnit":{"state":"translated","value":"Penyedia model mengembalikan kesalahan"}},
        "it": {"stringUnit":{"state":"translated","value":"Il fornitore del modello ha restituito un errore"}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"O provedor do modelo retornou um erro"}}
      }
    },
    "Try again, or switch to another model to continue.": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"可以重试，或切换模型继续。"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"可以重試，或切換模型繼續。"}},
        "ja": {"stringUnit":{"state":"translated","value":"再試行するか、別のモデルに切り替えて続行してください。"}},
        "ko": {"stringUnit":{"state":"translated","value":"다시 시도하거나 다른 모델로 전환하여 계속하세요."}},
        "de": {"stringUnit":{"state":"translated","value":"Versuche es erneut oder wechsle zu einem anderen Modell, um fortzufahren."}},
        "es": {"stringUnit":{"state":"translated","value":"Vuelve a intentarlo o cambia a otro modelo para continuar."}},
        "fr": {"stringUnit":{"state":"translated","value":"Réessayez ou choisissez un autre modèle pour continuer."}},
        "hi": {"stringUnit":{"state":"translated","value":"फिर से कोशिश करें या जारी रखने के लिए दूसरा मॉडल चुनें।"}},
        "id": {"stringUnit":{"state":"translated","value":"Coba lagi atau beralih ke model lain untuk melanjutkan."}},
        "it": {"stringUnit":{"state":"translated","value":"Riprova o passa a un altro modello per continuare."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"Tente novamente ou mude para outro modelo para continuar."}}
      }
    },
    "The current model is unavailable.": {
      "localizations": {
        "zh-Hans": {"stringUnit":{"state":"translated","value":"当前模型不可用。"}},
        "zh-Hant": {"stringUnit":{"state":"translated","value":"當前模型不可用。"}},
        "ja": {"stringUnit":{"state":"translated","value":"現在のモデルは利用できません。"}},
        "ko": {"stringUnit":{"state":"translated","value":"현재 모델을 사용할 수 없습니다."}},
        "de": {"stringUnit":{"state":"translated","value":"Das aktuelle Modell ist nicht verfügbar."}},
        "es": {"stringUnit":{"state":"translated","value":"El modelo actual no está disponible."}},
        "fr": {"stringUnit":{"state":"translated","value":"Le modèle actuel est indisponible."}},
        "hi": {"stringUnit":{"state":"translated","value":"वर्तमान मॉडल उपलब्ध नहीं है।"}},
        "id": {"stringUnit":{"state":"translated","value":"Model saat ini tidak tersedia."}},
        "it": {"stringUnit":{"state":"translated","value":"Il modello attuale non è disponibile."}},
        "pt-BR": {"stringUnit":{"state":"translated","value":"O modelo atual não está disponível."}}
      }
    }
  },
  "version": "1.0"
}
