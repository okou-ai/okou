    "Your model change was not saved. Choose it again to retry.": {
      "localizations": {
        "de": {
          "stringUnit": { "state": "translated", "value": "Ihre Modelländerung wurde nicht gespeichert. Wählen Sie das Modell erneut aus, um es noch einmal zu versuchen." }
        },
        "es": {
          "stringUnit": { "state": "translated", "value": "No se guardó el cambio de modelo. Vuelve a elegirlo para reintentarlo." }
        },
        "fr": {
          "stringUnit": { "state": "translated", "value": "Votre changement de modèle n’a pas été enregistré. Sélectionnez-le à nouveau pour réessayer." }
        },
        "hi": {
          "stringUnit": { "state": "translated", "value": "आपका मॉडल बदलाव सेव नहीं हुआ। फिर कोशिश करने के लिए उसे दोबारा चुनें।" }
        },
        "id": {
          "stringUnit": { "state": "translated", "value": "Perubahan model Anda tidak tersimpan. Pilih lagi untuk mencoba ulang." }
        },
        "it": {
          "stringUnit": { "state": "translated", "value": "La modifica del modello non è stata salvata. Selezionalo di nuovo per riprovare." }
        },
        "ja": {
          "stringUnit": { "state": "translated", "value": "モデルの変更は保存されませんでした。もう一度選択して再試行してください。" }
        },
        "ko": {
          "stringUnit": { "state": "translated", "value": "모델 변경 사항이 저장되지 않았습니다. 다시 선택하여 재시도하세요." }
        },
        "pt-BR": {
          "stringUnit": { "state": "translated", "value": "Sua alteração de modelo não foi salva. Escolha o modelo de novo para tentar novamente." }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "模型更改未保存。请重新选择以重试。" }
        },
        "zh-Hant": {
          "stringUnit": { "state": "translated", "value": "模型變更未儲存。請重新選擇以再試一次。" }
        }
      }
    },
