    "Build a website that explains my business, services, and how to contact me. Start with my business details and audience.": {
      "localizations": {
        "de": {
          "stringUnit": { "state": "translated", "value": "Erstelle eine Website über mein Unternehmen, meine Leistungen und Kontaktmöglichkeiten. Kläre zuerst die Geschäftsdaten und Zielgruppe." }
        },
        "es": {
          "stringUnit": { "state": "translated", "value": "Crea una web que explique mi negocio, mis servicios y cómo contactarme. Empieza por los detalles del negocio y la audiencia." }
        },
        "fr": {
          "stringUnit": { "state": "translated", "value": "Crée un site présentant mon entreprise, mes services et mes coordonnées. Commence par les détails de l'activité et le public visé." }
        },
        "hi": {
          "stringUnit": { "state": "translated", "value": "मेरे व्यवसाय, सेवाओं और संपर्क के तरीकों की वेबसाइट बनाएँ। पहले व्यवसाय और दर्शकों की जानकारी पूछें।" }
        },
        "id": {
          "stringUnit": { "state": "translated", "value": "Buat situs yang menjelaskan bisnis, layanan, dan cara menghubungi saya. Mulai dengan detail bisnis dan audiens." }
        },
        "it": {
          "stringUnit": { "state": "translated", "value": "Crea un sito che presenti attività, servizi e contatti. Inizia dai dettagli della mia attività e dal pubblico." }
        },
        "ja": {
          "stringUnit": { "state": "translated", "value": "事業、サービス、連絡方法を紹介するサイトを作ってください。事業の詳細と対象者を先に確認してください。" }
        },
        "ko": {
          "stringUnit": { "state": "translated", "value": "사업, 서비스, 연락 방법을 소개하는 웹사이트를 만들어 주세요. 사업 정보와 대상 고객을 먼저 확인해 주세요." }
        },
        "pt-BR": {
          "stringUnit": { "state": "translated", "value": "Crie um site que apresente meu negócio, serviços e formas de contato. Comece pelos detalhes do negócio e pelo público." }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "搭建一个网站，介绍我的生意、服务和联系方式。先从我的业务信息和受众开始。" }
        },
        "zh-Hant": {
          "stringUnit": { "state": "translated", "value": "搭建一個網站，介紹我的生意、服務和聯絡方式。先從我的業務資訊和受眾開始。" }
        }
      }
    },
