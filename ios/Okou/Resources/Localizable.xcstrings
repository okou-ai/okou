    "You've reached today's voice input limit.": {
      "localizations": {
        "de": {
          "stringUnit": { "state": "translated", "value": "Sie haben das heutige Limit für die Spracheingabe erreicht." }
        },
        "es": {
          "stringUnit": { "state": "translated", "value": "Has alcanzado el límite de entrada de voz de hoy." }
        },
        "fr": {
          "stringUnit": { "state": "translated", "value": "Vous avez atteint la limite de saisie vocale du jour." }
        },
        "hi": {
          "stringUnit": { "state": "translated", "value": "आप आज की वॉइस इनपुट सीमा तक पहुँच गए हैं।" }
        },
        "id": {
          "stringUnit": { "state": "translated", "value": "Anda telah mencapai batas input suara hari ini." }
        },
        "it": {
          "stringUnit": { "state": "translated", "value": "Hai raggiunto il limite di input vocale di oggi." }
        },
        "ja": {
          "stringUnit": { "state": "translated", "value": "本日の音声入力の上限に達しました。" }
        },
        "ko": {
          "stringUnit": { "state": "translated", "value": "오늘의 음성 입력 한도에 도달했습니다." }
        },
        "pt-BR": {
          "stringUnit": { "state": "translated", "value": "Você atingiu o limite de entrada de voz de hoje." }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "你已达到今日的语音输入上限。" }
        },
        "zh-Hant": {
          "stringUnit": { "state": "translated", "value": "你已達到今日的語音輸入上限。" }
        }
      }
    },
    "Your account or workspace changed. Please try again in the current workspace.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": { "state": "translated", "value": "Ihr Konto oder Arbeitsbereich hat sich geändert. Bitte versuchen Sie es im aktuellen Arbeitsbereich erneut." }
        },
        "en": {
          "stringUnit": { "state": "translated", "value": "Your account or workspace changed. Please try again in the current workspace." }
        },
        "es": {
          "stringUnit": { "state": "translated", "value": "Tu cuenta o espacio de trabajo ha cambiado. Vuelve a intentarlo en el espacio de trabajo actual." }
        },
        "fr": {
          "stringUnit": { "state": "translated", "value": "Votre compte ou espace de travail a changé. Veuillez réessayer dans l’espace de travail actuel." }
        },
        "hi": {
          "stringUnit": { "state": "translated", "value": "आपका खाता या वर्कस्पेस बदल गया है। कृपया मौजूदा वर्कस्पेस में फिर कोशिश करें।" }
        },
        "id": {
          "stringUnit": { "state": "translated", "value": "Akun atau ruang kerja Anda berubah. Silakan coba lagi di ruang kerja saat ini." }
        },
        "it": {
          "stringUnit": { "state": "translated", "value": "Il tuo account o la tua area di lavoro sono cambiati. Riprova nell'area di lavoro attuale." }
        },
        "ja": {
          "stringUnit": { "state": "translated", "value": "アカウントまたはワークスペースが変更されました。現在のワークスペースでもう一度お試しください。" }
        },
        "ko": {
          "stringUnit": { "state": "translated", "value": "계정 또는 워크스페이스가 변경되었습니다. 현재 워크스페이스에서 다시 시도하세요." }
        },
        "pt-BR": {
          "stringUnit": { "state": "translated", "value": "Sua conta ou espaço de trabalho mudou. Tente novamente no espaço de trabalho atual." }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "你的账号或工作区已更改。请在当前工作区中重试。" }
        },
        "zh-Hant": {
          "stringUnit": { "state": "translated", "value": "你的帳號或工作區已變更。請在目前的工作區中再試一次。" }
        }
      }
    },
    "Your chats could not be loaded. Try updating again.": {
      "localizations": {
        "de": {
          "stringUnit": { "state": "translated", "value": "Ihre Chats konnten nicht geladen werden. Versuchen Sie erneut, sie zu aktualisieren." }
        },
        "es": {
          "stringUnit": { "state": "translated", "value": "No se pudieron cargar tus chats. Vuelve a intentar actualizarlos." }
        },
        "fr": {
          "stringUnit": { "state": "translated", "value": "Impossible de charger vos discussions. Réessayez de les actualiser." }
        },
        "hi": {
          "stringUnit": { "state": "translated", "value": "आपकी चैट लोड नहीं हो सकीं। फिर से अपडेट करके देखें।" }
        },
        "id": {
          "stringUnit": { "state": "translated", "value": "Chat Anda tidak dapat dimuat. Coba perbarui lagi." }
        },
        "it": {
          "stringUnit": { "state": "translated", "value": "Impossibile caricare le tue chat. Prova di nuovo ad aggiornarle." }
        },
        "ja": {
          "stringUnit": { "state": "translated", "value": "チャットを読み込めませんでした。もう一度更新してください。" }
        },
        "ko": {
          "stringUnit": { "state": "translated", "value": "채팅을 불러올 수 없습니다. 다시 업데이트해 보세요." }
        },
        "pt-BR": {
          "stringUnit": { "state": "translated", "value": "Não foi possível carregar suas conversas. Tente atualizar novamente." }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "无法加载你的聊天。请再次尝试更新。" }
        },
        "zh-Hant": {
          "stringUnit": { "state": "translated", "value": "無法載入你的聊天。請再次嘗試更新。" }
        }
      }
    },
    "Your chats will appear here.": {
