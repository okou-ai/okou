    "Runs use the active account of each provider. Pull down to refresh usage.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "运行会使用各服务商当前启用的账号。下拉刷新用量。" }
        },
        "zh-Hant": {
          "stringUnit": { "state": "translated", "value": "執行會使用各服務商目前啟用的帳號。下拉以重新整理用量。" }
        },
        "ja": {
          "stringUnit": { "state": "translated", "value": "実行には各プロバイダの使用中のアカウントが使われます。下にスワイプして使用量を更新。" }
        },
        "ko": {
          "stringUnit": { "state": "translated", "value": "실행에는 각 제공자의 사용 중인 계정이 사용됩니다. 아래로 당겨 사용량을 새로 고치세요." }
        },
        "de": {
          "stringUnit": { "state": "translated", "value": "Ausführungen nutzen das aktive Konto jedes Anbieters. Zum Aktualisieren der Nutzung nach unten ziehen." }
        },
        "es": {
          "stringUnit": { "state": "translated", "value": "Las ejecuciones usan la cuenta activa de cada proveedor. Desliza hacia abajo para actualizar el uso." }
        },
        "fr": {
          "stringUnit": { "state": "translated", "value": "Les exécutions utilisent le compte actif de chaque fournisseur. Tirez vers le bas pour actualiser l’utilisation." }
        },
        "it": {
          "stringUnit": { "state": "translated", "value": "Le esecuzioni usano l’account attivo di ogni provider. Trascina in basso per aggiornare l’utilizzo." }
        },
        "pt-BR": {
          "stringUnit": { "state": "translated", "value": "As execuções usam a conta ativa de cada provedor. Puxe para baixo para atualizar o uso." }
        },
        "id": {
          "stringUnit": { "state": "translated", "value": "Eksekusi menggunakan akun aktif setiap penyedia. Tarik ke bawah untuk menyegarkan penggunaan." }
        },
        "hi": {
          "stringUnit": { "state": "translated", "value": "रन हर प्रदाता के सक्रिय खाते का इस्तेमाल करते हैं। उपयोग रिफ़्रेश करने के लिए नीचे खींचें।" }
        }
      }
    },
