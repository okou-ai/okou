          "stringUnit": { "state": "translated", "value": "पासवर्ड भूल गए या कोई और तरीका इस्तेमाल करना है?" }
        },
        "id": {
          "stringUnit": { "state": "translated", "value": "Lupa kata sandi atau ingin pakai metode lain?" }
        },
        "it": {
          "stringUnit": { "state": "translated", "value": "Password dimenticata o vuoi usare un altro metodo?" }
        },
        "ja": {
          "stringUnit": { "state": "translated", "value": "パスワードを忘れた場合・別の方法を使う場合" }
        },
        "ko": {
          "stringUnit": { "state": "translated", "value": "비밀번호를 잊으셨거나 다른 방법을 사용하시겠어요?" }
        },
        "pt-BR": {
          "stringUnit": { "state": "translated", "value": "Esqueceu a senha ou quer usar outro método?" }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "忘记密码或使用其他方式？" }
        },
        "zh-Hant": {
          "stringUnit": { "state": "translated", "value": "忘記密碼或使用其他方式？" }
        }
      }
    },
    "Future runs will use another active account. Runs already started keep their captured account.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": { "state": "translated", "value": "Künftige Ausführungen verwenden ein anderes aktives Konto. Bereits gestartete Ausführungen behalten ihr zugewiesenes Konto." }
        },
        "en": {
          "stringUnit": { "state": "translated", "value": "Future runs will use another active account. Runs already started keep their captured account." }
        },
        "es": {
          "stringUnit": { "state": "translated", "value": "Las próximas ejecuciones usarán otra cuenta activa. Las ejecuciones ya iniciadas mantienen la cuenta asignada." }
        },
        "fr": {
          "stringUnit": { "state": "translated", "value": "Les prochaines exécutions utiliseront un autre compte actif. Les exécutions déjà lancées conservent leur compte." }
        },
        "hi": {
          "stringUnit": { "state": "translated", "value": "आगे के रन किसी दूसरे सक्रिय खाते का उपयोग करेंगे। पहले से शुरू हो चुके रन अपना दर्ज खाता ही रखेंगे।" }
        },
        "id": {
          "stringUnit": { "state": "translated", "value": "Eksekusi berikutnya akan memakai akun aktif lain. Eksekusi yang sudah berjalan tetap memakai akun yang tercatat." }
        },
        "it": {
          "stringUnit": { "state": "translated", "value": "Le prossime esecuzioni useranno un altro account attivo. Quelle già avviate mantengono l'account assegnato." }
        },
        "ja": {
          "stringUnit": { "state": "translated", "value": "今後の実行では別の有効なアカウントが使用されます。すでに開始した実行は、開始時のアカウントを引き続き使用します。" }
        },
        "ko": {
          "stringUnit": { "state": "translated", "value": "이후 실행에서는 다른 활성 계정을 사용합니다. 이미 시작된 실행은 기존 계정을 계속 사용합니다." }
        },
        "pt-BR": {
          "stringUnit": { "state": "translated", "value": "As próximas execuções usarão outra conta ativa. As execuções já iniciadas mantêm a conta registrada." }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "后续运行将使用另一个可用账号。已开始的运行会继续使用原账号。" }
        },
        "zh-Hant": {
          "stringUnit": { "state": "translated", "value": "之後的執行將使用另一個可用帳號。已開始的執行會繼續使用原本的帳號。" }
        }
      }
    },
