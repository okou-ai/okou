        },
        "ja": {
          "stringUnit": { "state": "translated", "value": "選択したアカウントは利用できません。アカウントを選択するか、デフォルトを使用してください。" }
        },
        "ko": {
          "stringUnit": { "state": "translated", "value": "선택한 계정을 사용할 수 없습니다. 계정을 선택하거나 기본값을 사용하세요." }
        },
        "pt-BR": {
          "stringUnit": { "state": "translated", "value": "A conta selecionada está indisponível. Escolha uma conta ou use a padrão." }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "所选账号不可用。请选择一个账号或使用默认账号。" }
