    "Okou can't read usage or run tasks with this account until you sign in again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "重新登录之前，Okou 无法读取此账号的用量，也无法用它运行任务。" }
        },
        "zh-Hant": {
          "stringUnit": { "state": "translated", "value": "重新登入之前，Okou 無法讀取此帳號的用量，也無法用它執行任務。" }
        },
        "ja": {
          "stringUnit": { "state": "translated", "value": "再度サインインするまで、Okou はこのアカウントの使用量を読み取れず、タスクも実行できません。" }
        },
        "ko": {
          "stringUnit": { "state": "translated", "value": "다시 로그인하기 전까지 Okou는 이 계정의 사용량을 읽거나 작업을 실행할 수 없습니다." }
        },
        "de": {
          "stringUnit": { "state": "translated", "value": "Okou kann die Nutzung nicht lesen und keine Aufgaben mit diesem Konto ausführen, bis Sie sich erneut anmelden." }
        },
        "es": {
          "stringUnit": { "state": "translated", "value": "Okou no puede leer el uso ni ejecutar tareas con esta cuenta hasta que vuelvas a iniciar sesión." }
        },
        "fr": {
          "stringUnit": { "state": "translated", "value": "Okou ne peut ni lire l’utilisation ni exécuter des tâches avec ce compte tant que vous ne vous reconnectez pas." }
        },
        "it": {
          "stringUnit": { "state": "translated", "value": "Okou non può leggere l’utilizzo né eseguire attività con questo account finché non accedi di nuovo." }
        },
        "pt-BR": {
          "stringUnit": { "state": "translated", "value": "O Okou não consegue ler o uso nem executar tarefas com esta conta até você entrar novamente." }
        },
        "id": {
          "stringUnit": { "state": "translated", "value": "Okou tidak dapat membaca penggunaan atau menjalankan tugas dengan akun ini sampai Anda masuk lagi." }
        },
        "hi": {
          "stringUnit": { "state": "translated", "value": "दोबारा साइन इन करने तक Okou इस खाते का उपयोग नहीं पढ़ सकता और न ही इससे काम चला सकता है।" }
        }
      }
    },
