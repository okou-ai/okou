        },
        "ja": {
          "stringUnit": { "state": "translated", "value": "サブスクリプションのリセットクレジットを 1 回分使用します。この操作は取り消せません。" }
        },
        "ko": {
          "stringUnit": { "state": "translated", "value": "구독 초기화 크레딧 1회가 사용됩니다. 이 작업은 취소할 수 없습니다." }
        },
        "pt-BR": {
          "stringUnit": { "state": "translated", "value": "Isso usa um crédito de redefinição da assinatura. Não é possível desfazer." }
        },
