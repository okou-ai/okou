          "stringUnit": { "state": "translated", "value": "Esto consume un crédito de restablecimiento de la suscripción. No se puede deshacer." }
        },
        "fr": {
          "stringUnit": { "state": "translated", "value": "Cette action utilise un crédit de réinitialisation de l’abonnement. Elle est irréversible." }
        },
        "hi": {
          "stringUnit": { "state": "translated", "value": "इसमें एक सदस्यता रीसेट क्रेडिट लगेगा। इसे वापस नहीं लिया जा सकता।" }
        },
        "id": {
          "stringUnit": { "state": "translated", "value": "Ini memakai satu kredit reset langganan. Tindakan ini tidak dapat dibatalkan." }
        },
