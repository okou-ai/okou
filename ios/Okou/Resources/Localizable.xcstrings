    "Preview is unavailable for this file type. Share it or save it to Files to open it in another app.": {
      "localizations": {
        "de": {
          "stringUnit": { "state": "translated", "value": "Für diesen Dateityp ist keine Vorschau verfügbar. Teilen Sie die Datei oder sichern Sie sie in „Dateien“, um sie in einer anderen App zu öffnen." }
        },
        "es": {
          "stringUnit": { "state": "translated", "value": "La vista previa no está disponible para este tipo de archivo. Compártelo o guárdalo en Archivos para abrirlo en otra app." }
        },
        "fr": {
          "stringUnit": { "state": "translated", "value": "L’aperçu n’est pas disponible pour ce type de fichier. Partagez-le ou enregistrez-le dans Fichiers pour l’ouvrir dans une autre app." }
        },
        "hi": {
          "stringUnit": { "state": "translated", "value": "इस फ़ाइल प्रकार का प्रीव्यू उपलब्ध नहीं है। किसी दूसरे ऐप में खोलने के लिए इसे शेयर करें या फ़ाइल्स में सेव करें।" }
        },
        "id": {
          "stringUnit": { "state": "translated", "value": "Pratinjau tidak tersedia untuk jenis file ini. Bagikan atau simpan ke File untuk membukanya di app lain." }
        },
        "it": {
          "stringUnit": { "state": "translated", "value": "Anteprima non disponibile per questo tipo di file. Condividilo o salvalo in File per aprirlo in un'altra app." }
        },
        "ja": {
          "stringUnit": { "state": "translated", "value": "このファイル形式はプレビューできません。共有するか「ファイル」に保存して、ほかのアプリで開いてください。" }
        },
        "ko": {
          "stringUnit": { "state": "translated", "value": "이 파일 유형은 미리 볼 수 없습니다. 공유하거나 파일 앱에 저장한 후 다른 앱에서 여세요." }
        },
        "pt-BR": {
          "stringUnit": { "state": "translated", "value": "Não há pré-visualização para este tipo de arquivo. Compartilhe ou salve em Arquivos para abrir em outro app." }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "此文件类型无法预览。可分享或存储到“文件”，然后在其他 App 中打开。" }
