    "Open this connection to try again.": {
      "localizations": {
        "de": {
          "stringUnit": { "state": "translated", "value": "Öffnen Sie diese Verbindung, um es erneut zu versuchen." }
        },
        "es": {
          "stringUnit": { "state": "translated", "value": "Abre esta conexión para volver a intentarlo." }
        },
        "fr": {
          "stringUnit": { "state": "translated", "value": "Ouvrez cette connexion pour réessayer." }
        },
        "hi": {
          "stringUnit": { "state": "translated", "value": "फिर कोशिश करने के लिए यह कनेक्शन खोलें।" }
        },
        "id": {
          "stringUnit": { "state": "translated", "value": "Buka koneksi ini untuk mencoba lagi." }
        },
        "it": {
          "stringUnit": { "state": "translated", "value": "Apri questa connessione per riprovare." }
        },
        "ja": {
          "stringUnit": { "state": "translated", "value": "この接続を開いて再試行してください。" }
        },
        "ko": {
          "stringUnit": { "state": "translated", "value": "이 연결을 열어 다시 시도하세요." }
        },
        "pt-BR": {
          "stringUnit": { "state": "translated", "value": "Abra esta conexão para tentar novamente." }
        },
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "打开此连接以重试。" }
        },
        "zh-Hant": {
          "stringUnit": { "state": "translated", "value": "開啟此連線以再試一次。" }
        }
      }
    },
    "Opens a new chat and starts voice input without sending a message.": {
      "localizations": {
        "de": {
          "stringUnit": { "state": "translated", "value": "Öffnet einen neuen Chat und startet die Spracheingabe, ohne eine Nachricht zu senden." }
        },
        "es": {
          "stringUnit": { "state": "translated", "value": "Abre un chat nuevo e inicia la entrada de voz sin enviar ningún mensaje." }
        },
        "fr": {
          "stringUnit": { "state": "translated", "value": "Ouvre une nouvelle discussion et démarre la saisie vocale sans envoyer de message." }
        },
        "hi": {
          "stringUnit": { "state": "translated", "value": "नई चैट खोलता है और संदेश भेजे बिना बोलकर लिखना शुरू करता है।" }
        },
        "id": {
          "stringUnit": { "state": "translated", "value": "Membuka chat baru dan memulai input suara tanpa mengirim pesan." }
        },
        "it": {
          "stringUnit": { "state": "translated", "value": "Apre una nuova chat e avvia l'input vocale senza inviare messaggi." }
        },
        "ja": {
          "stringUnit": { "state": "translated", "value": "新しいチャットを開き、メッセージを送信せずに音声入力を開始します。" }
        },
        "ko": {
