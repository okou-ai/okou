        }
      }
    },
    "The selected account is unavailable. Choose an account or use default.": {
      "localizations": {
        "de": {
          "stringUnit": { "state": "translated", "value": "Das ausgewählte Konto ist nicht verfügbar. Wählen Sie ein Konto oder verwenden Sie das Standardkonto." }
        },
        "es": {
          "stringUnit": { "state": "translated", "value": "La cuenta seleccionada no está disponible. Elige una cuenta o usa la predeterminada." }
        },
        "fr": {
          "stringUnit": { "state": "translated", "value": "Le compte sélectionné est indisponible. Choisissez un compte ou utilisez celui par défaut." }
        },
        "hi": {
          "stringUnit": { "state": "translated", "value": "चुना गया खाता उपलब्ध नहीं है। कोई खाता चुनें या डिफ़ॉल्ट इस्तेमाल करें।" }
        },
