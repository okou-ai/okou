# The instrumentation APK loads after the production app has been optimized.
# Preserve the public fixture/observation ABI used by the existing native suite;
# private implementations, SDK code and unused application types stay optimized.
# This is the same Release configuration used for publication, not a test-only
# change to optimization. Keep names obfuscatable: AGP rewrites the test APK
# using the tested app's R8 mapping.

-keep,allowobfuscation class ai.okou.android.MainActivity { public *; protected *; }
-keep,allowobfuscation class ai.okou.android.OkouApplication { public *; protected *; }
