# Incoming virtual calls cannot be discovered by tracing outgoing test calls.
# These are the production extension points implemented by TestOkouApplication
# and its service fixtures. Retain dispatch to their separately loaded overrides.
-keep,allowobfuscation class ai.okou.android.OkouApplication {
    public ai.okou.android.updates.AppUpdates getUpdates();
    public ai.okou.android.instructions.PersonalInstructionsDraftStore getInstructionsDrafts();
    public ai.okou.android.chat.ComposerJournalStore getComposerJournal();
    public ai.okou.android.auth.Authentication createAuthentication();
    public ai.okou.android.auth.WorkspaceSession createWorkspaceSession(ai.okou.android.auth.WorkspaceIdentity, ai.okou.android.api.WorkspaceTokenProvider);
}
-keep,allowobfuscation interface ai.okou.android.auth.Authentication { public *; }
-keep,allowobfuscation interface ai.okou.android.auth.WorkspaceSession { public *; }
-keep,allowobfuscation interface ai.okou.android.chat.ChatListService { public *; }
-keep,allowobfuscation interface ai.okou.android.chat.ConversationHistoryService { public *; }
-keep,allowobfuscation interface ai.okou.android.chat.ChatComposerService { public *; }
-keep,allowobfuscation interface ai.okou.android.chat.RealtimeService { public *; }
-keep,allowobfuscation interface ai.okou.android.instructions.PersonalInstructionsService { public *; }
-keep,allowobfuscation interface ai.okou.android.updates.UpdateService { public *; }
-keep,allowobfuscation interface ai.okou.android.updates.UpdateStore { public *; }

# R8 synthesizes this coroutine probe in the test APK after applying the app's
# mapping. Its generated call retains the intrinsic method name; keep that name
# and holder stable so it links to the app's copy rather than a renamed method.
-keep class kotlin.coroutines.jvm.internal.DebugProbesKt {
    public static void probeCoroutineSuspended(kotlin.coroutines.Continuation);
}
