[
  {
    "package": "guest-agent",
    "binary": "guest-agent",
    "pathEnv": "GUEST_AGENT_PATH",
    "bundledEnv": "BUNDLED_GUEST_AGENT",
    "destination": "/usr/local/bin/guest-agent"
  },
  {
    "package": "guest-storage-apply",
    "binary": "guest-storage-apply",
    "pathEnv": "GUEST_STORAGE_APPLY_PATH",
    "bundledEnv": "BUNDLED_GUEST_STORAGE_APPLY",
    "destination": "/usr/local/bin/guest-storage-apply"
  },
  {
    "package": "guest-init",
    "binary": "guest-init",
    "pathEnv": "GUEST_INIT_PATH",
    "bundledEnv": "BUNDLED_GUEST_INIT",
    "destination": "/sbin/guest-init"
  },
  {
    "package": "guest-state-restore",
    "binary": "guest-state-restore",
    "pathEnv": "GUEST_STATE_RESTORE_PATH",
    "bundledEnv": "BUNDLED_GUEST_STATE_RESTORE",
    "destination": "/sbin/guest-state-restore"
  },
  {
    "package": "guest-write-file",
    "binary": "guest-write-file",
    "pathEnv": "GUEST_WRITE_FILE_PATH",
    "bundledEnv": "BUNDLED_GUEST_WRITE_FILE",
    "destination": "/sbin/guest-write-file"
  },
  {
    "package": "guest-home-mount",
    "binary": "guest-home-mount",
    "pathEnv": "GUEST_HOME_MOUNT_PATH",
    "bundledEnv": "BUNDLED_GUEST_HOME_MOUNT",
    "destination": "/sbin/guest-home-mount"
  },
  {
    "package": "guest-tool-exec",
    "binary": "guest-tool-exec",
    "pathEnv": "GUEST_TOOL_EXEC_PATH",
    "bundledEnv": "BUNDLED_GUEST_TOOL_EXEC",
    "destination": "/usr/local/bin/guest-tool-exec"
  },
  {
    "package": "runner-rpc-client",
    "binary": "runner-rpc-client",
    "pathEnv": "RUNNER_RPC_CLIENT_PATH",
    "bundledEnv": "BUNDLED_RUNNER_RPC_CLIENT",
    "destination": "/usr/local/bin/runner-rpc-client"
  },
  {
    "package": "claude-mock",
    "binary": "claude-mock",
    "pathEnv": "CLAUDE_MOCK_PATH",
    "bundledEnv": "BUNDLED_CLAUDE_MOCK",
    "destination": "/usr/local/bin/claude-mock"
  },
  {
    "package": "codex-mock",
    "binary": "codex-mock",
    "pathEnv": "CODEX_MOCK_PATH",
    "bundledEnv": "BUNDLED_CODEX_MOCK",
    "destination": "/usr/local/bin/codex-mock"
  }
]
