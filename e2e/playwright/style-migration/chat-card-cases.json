{
  "version": 1,
  "batch": "chat-transcript-card",
  "cases": [
    {
      "id": "chat-transcript-card-light",
      "path": "/chats/:threadId",
      "theme": "light",
      "viewport": {
        "width": 1440,
        "height": 1000
      },
      "deviceScaleFactor": 1
    },
    {
      "id": "chat-transcript-card-dark",
      "path": "/chats/:threadId",
      "theme": "dark",
      "viewport": {
        "width": 1440,
        "height": 1000
      },
      "deviceScaleFactor": 1
    },
    {
      "id": "chat-transcript-card-light-retina",
      "path": "/chats/:threadId",
      "theme": "light",
      "viewport": {
        "width": 1440,
        "height": 1000
      },
      "deviceScaleFactor": 2
    },
    {
      "id": "chat-transcript-card-dark-retina",
      "path": "/chats/:threadId",
      "theme": "dark",
      "viewport": {
        "width": 1440,
        "height": 1000
      },
      "deviceScaleFactor": 2
    },
    {
      "id": "chat-transcript-card-narrow",
      "path": "/chats/:threadId",
      "theme": "light",
      "viewport": {
        "width": 390,
        "height": 844
      },
      "deviceScaleFactor": 2,
      "hasTouch": true,
      "isMobile": true
    },
    {
      "id": "chat-transcript-card-narrow-dark",
      "path": "/chats/:threadId",
      "theme": "dark",
      "viewport": {
        "width": 390,
        "height": 844
      },
      "deviceScaleFactor": 2,
      "hasTouch": true,
      "isMobile": true
    }
  ]
}
