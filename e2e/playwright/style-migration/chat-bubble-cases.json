{
  "version": 1,
  "batch": "chat-message-bubbles",
  "cases": [
    {
      "id": "chat-bubble-light",
      "path": "/chats/:threadId",
      "theme": "light",
      "viewport": {
        "width": 1280,
        "height": 900
      },
      "deviceScaleFactor": 1
    },
    {
      "id": "chat-bubble-dark",
      "path": "/chats/:threadId",
      "theme": "dark",
      "viewport": {
        "width": 1280,
        "height": 900
      },
      "deviceScaleFactor": 1
    },
    {
      "id": "chat-bubble-light-retina",
      "path": "/chats/:threadId",
      "theme": "light",
      "viewport": {
        "width": 1280,
        "height": 900
      },
      "deviceScaleFactor": 2
    },
    {
      "id": "chat-bubble-dark-retina",
      "path": "/chats/:threadId",
      "theme": "dark",
      "viewport": {
        "width": 1280,
        "height": 900
      },
      "deviceScaleFactor": 2
    },
    {
      "id": "chat-bubble-narrow",
      "path": "/chats/:threadId",
      "theme": "light",
      "viewport": {
        "width": 390,
        "height": 844
      },
      "deviceScaleFactor": 2,
      "hasTouch": true,
      "isMobile": true
    },
    {
      "id": "chat-bubble-narrow-dark",
      "path": "/chats/:threadId",
      "theme": "dark",
      "viewport": {
        "width": 390,
        "height": 844
      },
      "deviceScaleFactor": 2,
      "hasTouch": true,
      "isMobile": true
    },
    {
      "id": "chat-bubble-agent-profile-light",
      "path": "/agents/:agentId?tab=profile",
      "theme": "light",
      "viewport": {
        "width": 1280,
        "height": 900
      },
      "deviceScaleFactor": 1
    },
    {
      "id": "chat-bubble-agent-profile-dark",
      "path": "/agents/:agentId?tab=profile",
      "theme": "dark",
      "viewport": {
        "width": 1280,
        "height": 900
      },
      "deviceScaleFactor": 1
    }
  ]
}
