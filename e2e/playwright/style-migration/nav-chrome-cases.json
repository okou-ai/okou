{
  "version": 1,
  "batch": "nav-chrome",
  "cases": [
    {
      "id": "nav-chrome-light",
      "path": "/chats/:threadId",
      "theme": "light",
      "viewport": {
        "width": 1280,
        "height": 900
      },
      "deviceScaleFactor": 1
    },
    {
      "id": "nav-chrome-dark",
      "path": "/chats/:threadId",
      "theme": "dark",
      "viewport": {
        "width": 1280,
        "height": 900
      },
      "deviceScaleFactor": 1
    },
    {
      "id": "nav-chrome-light-retina",
      "path": "/chats/:threadId",
      "theme": "light",
      "viewport": {
        "width": 1280,
        "height": 900
      },
      "deviceScaleFactor": 2
    },
    {
      "id": "nav-chrome-dark-retina",
      "path": "/chats/:threadId",
      "theme": "dark",
      "viewport": {
        "width": 1280,
        "height": 900
      },
      "deviceScaleFactor": 2
    },
    {
      "id": "nav-chrome-narrow",
      "path": "/chats/:threadId",
      "theme": "light",
      "viewport": {
        "width": 700,
        "height": 900
      },
      "deviceScaleFactor": 2,
      "hasTouch": true,
      "isMobile": true
    },
    {
      "id": "nav-chrome-narrow-dark",
      "path": "/chats/:threadId",
      "theme": "dark",
      "viewport": {
        "width": 700,
        "height": 900
      },
      "deviceScaleFactor": 2,
      "hasTouch": true,
      "isMobile": true
    }
  ]
}
