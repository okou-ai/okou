{
  "version": 1,
  "batch": "composer-surface",
  "cases": [
    {
      "id": "composer-surface-light",
      "path": "/chats/:threadId",
      "theme": "light",
      "viewport": {
        "width": 1440,
        "height": 1000
      },
      "deviceScaleFactor": 1
    },
    {
      "id": "composer-surface-dark",
      "path": "/chats/:threadId",
      "theme": "dark",
      "viewport": {
        "width": 1440,
        "height": 1000
      },
      "deviceScaleFactor": 1
    },
    {
      "id": "composer-surface-light-retina",
      "path": "/chats/:threadId",
      "theme": "light",
      "viewport": {
        "width": 1440,
        "height": 1000
      },
      "deviceScaleFactor": 2
    },
    {
      "id": "composer-surface-dark-retina",
      "path": "/chats/:threadId",
      "theme": "dark",
      "viewport": {
        "width": 1440,
        "height": 1000
      },
      "deviceScaleFactor": 2
    },
    {
      "id": "composer-surface-shared-thread-light",
      "path": "/share/threads/:id",
      "theme": "light",
      "viewport": {
        "width": 1440,
        "height": 1000
      },
      "deviceScaleFactor": 1
    },
    {
      "id": "composer-surface-shared-thread-dark",
      "path": "/share/threads/:id",
      "theme": "dark",
      "viewport": {
        "width": 1440,
        "height": 1000
      },
      "deviceScaleFactor": 1
    },
    {
      "id": "composer-surface-narrow",
      "path": "/chats/:threadId",
      "theme": "light",
      "viewport": {
        "width": 390,
        "height": 844
      },
      "deviceScaleFactor": 2,
      "hasTouch": true,
      "isMobile": true
    },
    {
      "id": "composer-surface-narrow-dark",
      "path": "/chats/:threadId",
      "theme": "dark",
      "viewport": {
        "width": 390,
        "height": 844
      },
      "deviceScaleFactor": 2,
      "hasTouch": true,
      "isMobile": true
    }
  ]
}
