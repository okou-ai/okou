{
  "version": 1,
  "batch": "workspace-canvas",
  "cases": [
    {
      "id": "workspace-canvas-light",
      "path": "/chats/:threadId",
      "theme": "light",
      "viewport": {
        "width": 1440,
        "height": 1000
      },
      "deviceScaleFactor": 1
    },
    {
      "id": "workspace-canvas-dark",
      "path": "/chats/:threadId",
      "theme": "dark",
      "viewport": {
        "width": 1440,
        "height": 1000
      },
      "deviceScaleFactor": 1
    },
    {
      "id": "workspace-canvas-connectors-light",
      "path": "/connectors",
      "theme": "light",
      "viewport": {
        "width": 1440,
        "height": 1000
      },
      "deviceScaleFactor": 1
    },
    {
      "id": "workspace-canvas-shared-thread-dark",
      "path": "/share/threads/:id",
      "theme": "dark",
      "viewport": {
        "width": 1440,
        "height": 1000
      },
      "deviceScaleFactor": 1
    },
    {
      "id": "workspace-canvas-narrow",
      "path": "/chats/:threadId",
      "theme": "light",
      "viewport": {
        "width": 390,
        "height": 844
      },
      "deviceScaleFactor": 2,
      "hasTouch": true,
      "isMobile": true
    },
    {
      "id": "workspace-canvas-narrow-dark",
      "path": "/chats/:threadId",
      "theme": "dark",
      "viewport": {
        "width": 390,
        "height": 844
      },
      "deviceScaleFactor": 2,
      "hasTouch": true,
      "isMobile": true
    }
  ]
}
