{
  "name": "e2e",
  "version": "1.0.0",
  "description": "E2E tests for Okou CLI",
  "packageManager": "pnpm@10.33.4",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "tsx --test playwright/lib/*.test.ts",
    "style:migration": "tsx playwright/style-migration/run.ts",
    "style:migration:tone": "tsx playwright/style-migration/run-tone.ts",
    "style:migration:settings-select": "tsx playwright/style-migration/run-settings-select.ts",
    "style:migration:swatch": "tsx playwright/style-migration/run-swatch.ts",
    "style:migration:tone-preview": "tsx playwright/style-migration/run-tone-preview.ts",
    "style:migration:mic-motion": "tsx playwright/style-migration/run-mic-motion.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.3",
    "dotenv": "^17.4.2",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@types/pngjs": "6.0.5",
    "tsx": "^4.22.4",
    "typescript": "6.0.3"
  }
}
