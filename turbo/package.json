{
  "name": "okou",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=!@okouai/desktop",
    "desktop:dev": "OKOU_DESKTOP_PLATFORM_URL=https://app.vm7.ai:8443 pnpm -F @okouai/desktop dev:packaged",
    "desktop:dev:forge": "OKOU_DESKTOP_PLATFORM_URL=https://app.vm7.ai:8443 pnpm -F @okouai/desktop dev",
    "desktop:make": "pnpm -F @okouai/desktop make",
    "lint": "turbo run lint --concurrency=1",
    "lint:style": "node --test scripts/style-policy.test.mjs && node scripts/style-policy.mjs && node --test scripts/style-migration.test.mjs && node scripts/style-migration.mjs && eslint --config eslint.style.config.mjs --no-inline-config --max-warnings 0 'apps/platform/src/**/*.{css,ts,tsx}' 'packages/ui/src/**/*.{css,ts,tsx}' || { echo 'Style lint failed. Read docs/styles.md for the style guide before fixing these errors. Use Tailwind utilities and registered tokens; do not expand the allowlist or legacy baseline for business styling.' >&2; exit 1; }",
    "lint:style:prune": "node scripts/style-policy.mjs --prune",
    "format": "prettier --write --ignore-unknown .",
    "check-types": "turbo run check-types --concurrency=1",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:perf": "VITEST_PERF=1 vitest --run",
    "html-resource-index:build": "tsx scripts/build-html-resource-index.ts",
    "profile-tests": "bash scripts/profile-tests.sh",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files",
    "knip:production": "knip --production --strict",
    "dev:status": "bash scripts/dev-server-check.sh",
    "runner": "bash ../scripts/dev-runner.sh deploy",
    "runner:local": "bash ../scripts/dev-runner.sh deploy-local",
    "deploy-cli:local": "bash ../scripts/deploy-cli-local.sh",
    "runner:submit": "bash ../scripts/dev-runner.sh submit",
    "runner:exec": "bash ../scripts/dev-runner.sh exec",
    "runner:remove": "bash ../scripts/dev-runner.sh remove",
    "style:migration:inventory": "node scripts/style-migration.mjs --json"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@eslint/css": "^2.0.0",
    "@eslint/css-tree": "^4.1.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "knip": "^5.63.1",
    "prettier": "^3.6.2",
    "tailwind-csstree": "^0.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "turbo": "^2.10.12",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.19.0"
  }
}
