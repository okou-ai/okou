{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/cli": {
      "entry": [
        "src/**/__tests__/**/*.{test,spec}.ts",
        "src/**/*.{test,spec}.ts"
      ],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@types/tar", "yaml"],
      "ignoreBinaries": ["agent-browser", "ffmpeg", "ffprobe"],
      "tsup": {
        "config": ["tsup.config.ts"]
      }
    },
    "apps/api": {
      "entry": [
        "src/index.ts",
        "src/server.ts",
        "src/signals/context/hono.ts",
        "src/signals/context/wait-until.ts",
        "src/signals/external/clerk.ts",
        "src/signals/external/stripe-client.ts",
        "src/signals/external/env.ts",
        "src/scripts/**/*.ts",
        "src/**/*.{test,spec}.ts",
        "scripts/erasure-bridge/{acceptance,child}.ts"
      ],
      "project": ["src/**/*.ts", "scripts/erasure-bridge/*.ts"],
      "ignoreDependencies": ["@hono/node-server-v1", "clerk"],
      "ignoreBinaries": ["openssl"]
    },
    "apps/platform": {
      "entry": [
        "src/main.ts",
        "src/clerk-ui.ts",
        "i18next.config.ts",
        "scripts/bench-p90-reporter.ts",
        "scripts/check-build-config.node.ts",
        "src/**/__benches__/**/*.bench.tsx",
        "**/*.{test,spec}.ts?(x)"
      ],
      "project": ["**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "@sentry/cli",
        "idb",
        "tailwindcss",
        "typescript-eslint"
      ]
    },
    "apps/host-worker": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "*.config.mjs"],
      "ignoreDependencies": ["eslint", "oxlint", "wrangler"],
      "ignoreBinaries": ["eslint", "oxlint", "wrangler"]
    },
    "apps/app-worker": {
      "entry": ["src/index.ts", "src/worker.js"],
      "project": ["src/**/*.{js,ts}", "*.config.mjs"],
      "ignoreDependencies": ["eslint", "oxlint", "wrangler"],
      "ignoreBinaries": ["eslint", "oxlint", "wrangler"]
    },
    "apps/desktop": {
      "entry": [
        "forge.config.js",
        "vite.renderer.config.ts",
        "src/main.ts",
        "src/preload.ts",
        "src/renderer/main.tsx",
        "src/**/*.{test,spec}.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}", "*.{js,ts}"],
      "ignoreDependencies": [
        "@electron-forge/cli",
        "@electron-forge/maker-zip",
        "@modelcontextprotocol/server-filesystem",
        "oxlint",
        "tsup"
      ],
      "ignoreBinaries": ["electron-forge", "oxlint", "tsup"]
    },
    "packages/core": {
      "entry": [
        "src/**/__tests__/**/*.{test,spec}.ts",
        "src/**/*.{test,spec}.ts"
      ],
      "project": ["src/**/*.ts"]
    },
    "packages/connectors": {
      "entry": [
        "src/**/__tests__/**/*.{test,spec}.ts",
        "src/**/*.{test,spec}.ts"
      ],
      "project": ["src/**/*.ts"]
    },
    "packages/api-contracts": {
      "entry": [
        "src/runtime-api-schema/cli.ts",
        "src/**/__tests__/**/*.{test,spec}.ts",
        "src/**/*.{test,spec}.ts"
      ],
      "project": ["src/**/*.ts"],
      "ignoreBinaries": ["rustfmt"]
    },
    "packages/db": {
      "entry": [
        "src/index.ts",
        "src/**/__tests__/**/*.{test,spec}.ts",
        "src/**/*.{test,spec}.ts",
        "scripts/**/*.ts"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "drizzle.config.ts"],
      "ignoreBinaries": ["drizzle-kit", "psql"]
    },
    "packages/ui": {
      "entry": [
        "src/**/__tests__/**/*.{test,spec}.{ts,tsx}",
        "src/**/*.{test,spec}.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["autoprefixer"]
    },
    "packages/eslint-config": {
      "entry": [],
      "project": ["**/*.js"]
    },
    "packages/eslint-rules": {
      "entry": ["src/index.ts", "src/**/*.{test,spec}.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/typescript-config": {
      "entry": [],
      "project": ["*.json"]
    },
    "packages/proxy": {
      "entry": [],
      "project": ["**/*.{js,json}"]
    },
    "packages/pi-agent-runtime": {
      "entry": ["src/**/*.{test,spec}.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreIssues": {
    "packages/eslint-rules/src/api/rules/no-package-variable.ts": ["types"],
    "packages/eslint-rules/src/api/rules/no-store-in-params.ts": ["types"],
    "packages/eslint-rules/src/api/utils.ts": ["types"],
    "packages/eslint-rules/src/ccstate/utils.ts": ["types"]
  },
  "ignore": [
    "**/*.d.ts",
    "dist/**",
    "build/**",
    "coverage/**",
    "apps/platform/src/mocks/ably.ts",
    "apps/platform/src/mocks/mermaid.ts",
    "scripts/rebuild-snapshots.ts",
    "scripts/rebuild-snapshots-from-db.ts",
    "scripts/analyze-cpuprofile.mjs",
    "scripts/analyze-call-frequency.mjs",
    "scripts/analyze-batching.mjs",
    "scripts/analyze-react-renders.mjs",
    "scripts/analyze-rewind-cause.mjs",
    "scripts/analyze-rewind.mjs",
    "scripts/dump-rewind-chains.mjs",
    "scripts/measure-memory.mjs"
  ],
  "ignoreDependencies": [
    "@commitlint/cli",
    "oxlint",
    "oxlint-tsgolint",
    "playwright"
  ],
  "ignoreBinaries": ["oxlint", "vite"],
  "ignoreWorkspaces": [],
  "ignoreUnresolved": ["\\.generated$"],
  "ignoreExportsUsedInFile": true
}
