{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "zero-host-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-13",
  "images": { "binding": "IMAGES" },
  "routes": [
    { "pattern": "a.okou.io/*", "zone_name": "okou.io" },
    {
      "pattern": "*.sites.vm0.io/*",
      "zone_name": "vm0.io",
    },
    {
      "pattern": "*.okou.app/*",
      "zone_name": "okou.app",
    },
  ],
  "vars": {
    "HOST_DOMAIN": "sites.vm0.io",
    "OKOU_HOST_DOMAIN": "okou.app",
    "PUBLIC_ARTIFACT_HOST": "a.okou.io",
  },
  "r2_buckets": [
    {
      "binding": "PUBLIC_ARTIFACTS_BUCKET",
      "bucket_name": "user-artifact-prod",
    },
    {
      "binding": "HOSTED_SITES_BUCKET",
      "bucket_name": "vm0-hosted-sites",
    },
    {
      "binding": "PRIVATE_ARTIFACTS_BUCKET",
      "bucket_name": "user-artifact-private-prod",
    },
  ],
  "env": {
    "test": {
      "images": { "binding": "IMAGES" },
      "routes": [
        {
          "pattern": "*.sites.vm7.io/*",
          "zone_name": "vm7.io",
        },
      ],
      "vars": {
        "HOST_DOMAIN": "sites.vm7.io",
        "OKOU_HOST_DOMAIN": "sites.vm7.io",
        "PUBLIC_ARTIFACT_HOST": "files.sites.vm7.io",
      },
      "r2_buckets": [
        {
          "binding": "PUBLIC_ARTIFACTS_BUCKET",
          "bucket_name": "user-artifact-dev",
        },
        {
          "binding": "HOSTED_SITES_BUCKET",
          "bucket_name": "vm0-hosted-sites-dev",
        },
        {
          "binding": "PRIVATE_ARTIFACTS_BUCKET",
          "bucket_name": "user-artifact-private-dev",
        },
      ],
    },
  },
}
