{
  "name": "@okouai/host-worker",
  "version": "1.9.32",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "pnpm lint:banner && oxlint && eslint . --max-warnings 0",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:production": "wrangler deploy --env=\"\"",
    "deploy:test": "wrangler deploy --env test",
    "build:banner": "tsx scripts/build-banner.ts",
    "lint:banner": "tsx scripts/build-banner.ts --check"
  },
  "devDependencies": {
    "@okouai/eslint-config": "workspace:*",
    "@okouai/eslint-rules": "workspace:*",
    "@okouai/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "0.28.2",
    "eslint": "^9.34.0",
    "fflate": "^0.8.3",
    "happy-dom": "^21.0.4",
    "msw": "^2.13.2",
    "oxlint": "^1.75.0",
    "postcss": "8.5.25",
    "tsx": "^4.21.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "entities": "7.0.1",
