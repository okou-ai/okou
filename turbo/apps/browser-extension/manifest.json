{
  "manifest_version": 3,
  "name": "Okou Browser",
  "version": "0.5.4",
  "minimum_chrome_version": "102",
  "description": "Organize source-window tabs and expose native browser capabilities over CDP.",
  "permissions": ["webNavigation", "tabs"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "css": ["page-fonts.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "Okou Browser"
  },
  "externally_connectable": {
    "matches": ["http://*/*", "https://*/*"]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
