{
  "manifest_version": 3,
  "name": "Okou Browser",
  "version": "0.5.0",
  "minimum_chrome_version": "102",
  "description": "Organize source-window tabs and expose native browser capabilities over CDP.",
  "permissions": [
    "webNavigation",
    "tabs"
  ],
  "action": {
    "default_title": "Okou Browser"
  },
  "externally_connectable": {
    "matches": [
      "http://*/*",
      "https://*/*"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
