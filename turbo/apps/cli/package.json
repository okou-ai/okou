{
  "name": "@okouai/cli",
  "version": "9.339.1",
  "private": true,
  "description": "Okou command-line interface",
  "repository": {
    "type": "git",
    "url": "https://github.com/vm0-ai/vm0",
    "directory": "turbo/apps/cli"
  },
  "type": "module",
  "bin": {
    "okou": "./dist/okou.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "cp package.json dist/ && pnpm json -I -f dist/package.json -e 'this.name=\"@okouai/cli\"; delete this.scripts; delete this.devDependencies; this.bin={okou:\"okou.js\"}; this.files=[\"*.js\",\"*.js.map\",\"*.wasm\",\"migrations/*.sql\"]'",
    "dev": "tsup --watch",
    "bench:startup": "pnpm build && OKOU_STARTUP_BENCH=1 vitest run src/__tests__/okou-startup.bench.test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint && oxlint --type-aware -c ../../.oxlintrc.typeaware.json && eslint . --max-warnings 0",
    "check-types": "pnpm --filter @okouai/pi-agent-runtime run build && tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@sentry/node": "^10.73.0",
    "@types/node": "^24.3.0",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/tar": "^6.1.13",
    "@okouai/api-contracts": "workspace:*",
    "@okouai/connectors": "workspace:*",
    "@okouai/core": "workspace:*",
    "@okouai/eslint-config": "workspace:*",
    "@okouai/pi-agent-runtime": "workspace:*",
    "@okouai/typescript-config": "workspace:*",
    "@zip.js/zip.js": "^2.14.1",
    "ably": "^2.21.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.0",
    "entities": "7.0.1",
    "eslint": "^9.34.0",
    "ignore": "^7.0.5",
    "json": "^11.0.0",
    "msw": "^2.13.2",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "prompts": "^2.4.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tar": "^7.5.7",
    "tsup": "^8.5.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "undici": "^8.10.2",
    "vitest": "^5.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  }
}
