{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "okou-wechat-gateway-unconfigured",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "WECHAT_GATEWAY_ENABLED": "false" },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WechatReceiver"] }],
  "env": {
    "test": {
      "name": "okou-wechat-gateway-test",
      "workers_dev": true,
      "vars": { "WECHAT_GATEWAY_ENABLED": "false" },
      "durable_objects": {
        "bindings": [
          { "name": "WECHAT_RECEIVER", "class_name": "WechatReceiver" },
        ],
      },
    },
    "production": {
      "name": "okou-wechat-gateway-production",
      "workers_dev": true,
      "vars": { "WECHAT_GATEWAY_ENABLED": "false" },
      "durable_objects": {
        "bindings": [
          { "name": "WECHAT_RECEIVER", "class_name": "WechatReceiver" },
        ],
      },
    },
  },
}
