{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "disableSourceOfProjectReferenceRedirect": true,
    "tsBuildInfoFile": "./.typecheck/tests.tsbuildinfo",
    "rootDir": "."
  },
  "include": [
    "src/**/__benches__/**/*",
    "src/**/__tests__/**/*",
    "src/test-fixtures/**/*",
    "src/**/*.bench.ts",
    "src/**/*.spec.ts",
    "src/**/*.suite.ts",
    "src/**/*.test.ts"
  ],
  "exclude": ["node_modules", "dist", "src/__tests__/vercel-crons.test.ts"],
  "references": [
    { "path": "./tsconfig.gateways.json" },
    { "path": "./tsconfig.core.json" },
    { "path": "./tsconfig.routes.json" }
  ]
}
