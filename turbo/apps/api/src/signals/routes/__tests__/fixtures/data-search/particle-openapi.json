{
  "_review": {
    "sourceUrl": "https://www.firecrawl.dev/alexandria/agents/providers/particle/openapi.json",
    "reviewedAt": "2026-10-22",
    "sourceFile": "particle-openapi.json",
    "sourceSha256": "17be38d9c542dd740294ad0fb0d582dab58ba5d9e6c42abda9acdacc9ec0f829"
  },
  "x-firecrawl-credit-cost": {
    "min": 5,
    "max": 50
  },
  "x-firecrawl-capabilities": [
    {
      "key": "podcasts/search",
      "credits_per_call": 5
    }
  ],
  "paths": {
    "/v2/scrape": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["alexandria"],
                "properties": {
                  "alexandria": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": ["provider", "capability", "options"],
                        "properties": {
                          "provider": {
                            "type": "string",
                            "const": "particle"
                          },
                          "capability": {
                            "type": "string",
                            "const": "podcasts/search"
                          },
                          "options": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "q": {
                                "type": "string",
                                "description": "Show name, forgiving of typos, missing words and qualifiers (offline jon favreau, equity techcrunch).",
                                "example": "<q>"
                              },
                              "topic_id": {
                                "type": "string",
                                "description": "Restrict to a topic, by topic id or ancestry slug such as technology/artificial-intelligence. Matches shows where the topic is at least a fifth of their episodes.",
                                "example": "<topic_id>"
                              },
                              "language": {
                                "type": "string",
                                "description": "ISO 639-1 language code, for example en or fr. Matches the primary subtag, so fr covers fr-CA.",
                                "example": "<language>"
                              },
                              "sort": {
                                "type": "string",
                                "description": "relevance ranks by match quality (the default with q); popularity orders by global popularity percentile.",
                                "example": "relevance",
                                "enum": ["relevance", "popularity"]
                              },
                              "suitability_tier": {
                                "type": "string",
                                "description": "Only shows whose latest brand-suitability assessment is this IAB Tech Lab tier. Shows never assessed are excluded when set.",
                                "example": "SAFE",
                                "enum": [
                                  "SAFE",
                                  "LIMITED",
                                  "SENSITIVE",
                                  "UNSAFE"
                                ]
                              },
                              "popularity_threshold": {
                                "type": "number",
                                "description": "Only shows at or above this global popularity percentile, in (0, 1].",
                                "example": 1
                              },
                              "guest_frequency": {
                                "type": "string",
                                "description": "How often episodes feature a guest, comma-separated to match any: for example regular,always for interview shows, never for shows without guests.",
                                "example": "<guest_frequency>"
                              },
                              "format_signal": {
                                "type": "string",
                                "description": "Detected production formats, comma-separated to match any: interview, panel, call_in, solo_narrated.",
                                "example": "<format_signal>"
                              },
                              "has_ads": {
                                "type": "string",
                                "description": "true for shows with detected advertising, false for ad-free shows with enough analysed episodes to say so.",
                                "example": "true",
                                "enum": ["true", "false"]
                              },
                              "has_video": {
                                "type": "string",
                                "description": "Whether episodes have discovered video versions.",
                                "example": "true",
                                "enum": ["true", "false"]
                              },
                              "min_avg_episode_minutes": {
                                "type": "number",
                                "description": "Only shows whose average episode runs at least this many minutes.",
                                "example": 10
                              },
                              "max_avg_episode_minutes": {
                                "type": "number",
                                "description": "Only shows whose average episode runs at most this many minutes.",
                                "example": 10
                              },
                              "min_episodes_per_week": {
                                "type": "number",
                                "description": "Only shows publishing at least this many episodes a week over the trailing 90 days.",
                                "example": 10
                              },
                              "max_episodes_per_week": {
                                "type": "number",
                                "description": "Only shows publishing at most this many episodes a week.",
                                "example": 10
                              },
                              "publishing_status": {
                                "type": "string",
                                "description": "active has released an episode in the last 90 days; dormant has not.",
                                "example": "active",
                                "enum": ["active", "dormant"]
                              },
                              "limit": {
                                "type": "number",
                                "description": "Maximum records to return.",
                                "example": 25
                              },
                              "cursor": {
                                "type": "string",
                                "description": "Opaque cursor from a previous page. Omit for the first page; send the same filters with it.",
                                "example": "<cursor>"
                              }
                            },
                            "required": ["q"]
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
