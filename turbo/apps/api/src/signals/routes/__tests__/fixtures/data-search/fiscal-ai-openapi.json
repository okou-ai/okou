{
  "_review": {
    "sourceUrl": "https://www.firecrawl.dev/alexandria/agents/providers/fiscal-ai/openapi.json",
    "reviewedAt": "2026-10-22",
    "sourceFile": "fiscal-ai-openapi.json",
    "sourceSha256": "d0611df38ebc87f0d545631fa2fe86e4eea5929601e6b702eca89e8843f15fef"
  },
  "x-firecrawl-credit-cost": {
    "min": 0,
    "max": 30
  },
  "x-firecrawl-capabilities": [
    {
      "key": "company/profile",
      "credits_per_call": 30
    }
  ],
  "paths": {
    "/v2/scrape": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["alexandria"],
                "properties": {
                  "alexandria": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": ["provider", "capability", "options"],
                        "properties": {
                          "provider": {
                            "type": "string",
                            "const": "fiscal-ai"
                          },
                          "capability": {
                            "type": "string",
                            "const": "company/profile"
                          },
                          "options": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "fscl": {
                                "type": "string",
                                "description": "Fiscal.ai's stable company identifier, the `companyFiscalIdentifier` field. The only identifier that survives a ticker change or a relisting, so prefer it when carrying a company between calls.",
                                "example": "<fscl>"
                              },
                              "companyKey": {
                                "type": "string",
                                "description": "Exchange and ticker joined by an underscore: `NASDAQ_MSFT` for US and Canadian listings, or MIC code and ticker elsewhere, as in `XWAR_PKN`.",
                                "example": "NASDAQ_MSFT"
                              },
                              "ticker": {
                                "type": "string",
                                "description": "Ticker symbol, for example MSFT. Only unique within an exchange, so pass `exchange` with it.",
                                "example": "AAPL"
                              },
                              "exchange": {
                                "type": "string",
                                "description": "Exchange code for `ticker`, for example NASDAQ, or a MIC code for a non-US/CA listing.",
                                "example": "<exchange>"
                              },
                              "cusip": {
                                "type": "string",
                                "description": "CUSIP of the security. Licensed identifier.",
                                "example": "<cusip>"
                              },
                              "isin": {
                                "type": "string",
                                "description": "ISIN of the security. Licensed identifier.",
                                "example": "<isin>"
                              },
                              "figi": {
                                "type": "string",
                                "description": "OpenFIGI identifier of the security. Licensed identifier.",
                                "example": "<figi>"
                              },
                              "cik": {
                                "type": "string",
                                "description": "SEC Central Index Key. Use when a company has no ticker, or after a rename.",
                                "example": "<cik>"
                              }
                            },
                            "allOf": [
                              {
                                "anyOf": [
                                  {
                                    "required": ["fscl"]
                                  },
                                  {
                                    "required": ["companyKey"]
                                  },
                                  {
                                    "required": ["ticker"]
                                  },
                                  {
                                    "required": ["cusip"]
                                  },
                                  {
                                    "required": ["isin"]
                                  },
                                  {
                                    "required": ["figi"]
                                  },
                                  {
                                    "required": ["cik"]
                                  }
                                ]
                              }
                            ]
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
