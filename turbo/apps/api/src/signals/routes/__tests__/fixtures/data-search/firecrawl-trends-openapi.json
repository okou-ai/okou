{
  "_review": {
    "sourceUrl": "https://www.firecrawl.dev/alexandria/agents/providers/firecrawl-trends/openapi.json",
    "reviewedAt": "2026-10-22",
    "sourceFile": "firecrawl-trends-openapi.json",
    "sourceSha256": "8a84d0d659e48a5467aa933658e82798d720f29f3e047a3d19d7ba8b435b4511"
  },
  "x-firecrawl-credit-cost": {
    "min": 0,
    "max": 5
  },
  "x-firecrawl-capabilities": [
    {
      "key": "trends/related_queries",
      "credits_per_call": 5
    }
  ],
  "paths": {
    "/v2/scrape": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["alexandria"],
                "properties": {
                  "alexandria": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": ["provider", "capability", "options"],
                        "properties": {
                          "provider": {
                            "type": "string",
                            "const": "firecrawl-trends"
                          },
                          "capability": {
                            "type": "string",
                            "const": "trends/related_queries"
                          },
                          "options": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "category": {
                                "type": "number",
                                "description": "Trends category id; 0 is all categories.",
                                "example": 0
                              },
                              "geo": {
                                "type": "string",
                                "description": "Location: empty for worldwide, an ISO country (US), region (US-CA) or US metro (US-CA-807). Pattern: ^([A-Z]{2}(-[A-Z0-9]{1,3}(-[0-9]{3})?)?)?$.",
                                "example": "<geo>"
                              },
                              "keyword": {
                                "type": "string",
                                "description": "One search term or topic id from suggestions; no commas.",
                                "example": "<keyword>"
                              },
                              "property": {
                                "type": "string",
                                "description": "Which search to measure: web, images, news, youtube or shopping.",
                                "example": "web",
                                "enum": [
                                  "web",
                                  "images",
                                  "news",
                                  "youtube",
                                  "shopping"
                                ]
                              },
                              "time": {
                                "type": "string",
                                "description": "Time range: now 1-H, now 4-H, now 1-d, now 7-d, today 1-m, today 3-m, today 12-m, today 5-y, all, or `YYYY-MM-DD YYYY-MM-DD` (from 2004-01-01). Shorter ranges give finer buckets (minute, hour, day); longer ones week or month. Pattern: ^(now 1-H|now 4-H|now 1-d|now 7-d|today 1-m|today 3-m|today 12-m|today 5-y|all|[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{4}-[0-9]{2}-[0-9]{2})$.",
                                "example": "today 12-m"
                              }
                            },
                            "required": ["keyword"]
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
