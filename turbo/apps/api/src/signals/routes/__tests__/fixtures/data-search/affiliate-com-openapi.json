    {
      "key": "merchants/search",
      "credits_per_call": 25
    }
  ],
  "paths": {
    "/v2/scrape": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["alexandria"],
                "properties": {
                  "alexandria": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": ["provider", "capability"],
                        "properties": {
                          "provider": {
                            "type": "string",
                            "const": "affiliate-com"
                          },
                          "capability": {
                            "type": "string",
                            "const": "merchants/search"
                          },
                          "options": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "search": {
                                "type": "string",
                                "description": "Case-insensitive fragment of the merchant name or home_url, for example `Walmart` or `walmart.com`. Does not match IDs.",
                                "example": "<search>"
                              },
                              "network_ids": {
                                "type": "string",
                                "description": "Comma-separated numeric network IDs, as in a merchant's `network.id`.",
                                "example": "network.id"
                              },
                              "origin_ids": {
                                "type": "string",
                                "description": "Comma-separated merchant IDs as the source network assigns them.",
                                "example": "<origin_ids>"
                              },
                              "canonical_ids": {
                                "type": "string",
                                "description": "Comma-separated canonical `mer_` merchant IDs.",
                                "example": "mer_"
                              },
                              "category_ids": {
                                "type": "string",
                                "description": "Comma-separated `cat_` category IDs.",
                                "example": "cat_"
                              },
                              "category_name": {
                                "type": "string",
                                "description": "Category name filter.",
                                "example": "<category_name>"
                              },
                              "countries": {
                                "type": "string",
                                "description": "Comma-separated ISO 3166-1 alpha-2 codes the merchant operates in, for example `US,CA`.",
                                "example": "US,CA"
                              },
                              "countries_origin": {
                                "type": "string",
                                "description": "Comma-separated codes for the merchant's origin country.",
                                "example": "<countries_origin>"
                              },
                              "countries_market": {
                                "type": "string",
                                "description": "Comma-separated codes for the merchant's market countries.",
                                "example": "<countries_market>"
                              },
                              "currencies": {
                                "type": "string",
                                "description": "Comma-separated ISO 4217 codes.",
                                "example": "<currencies>"
                              },
                              "feed_languages": {
                                "type": "string",
                                "description": "Comma-separated ISO 639-1 codes of the product feed.",
                                "example": "<feed_languages>"
                              },
                              "merchant_types": {
                                "type": "string",
                                "description": "Comma-separated: `standard`, `asn` (Amazon Seller Network).",
                                "example": "<merchant_types>"
                              },
                              "product_count_min": {
                                "type": "number",
                                "description": "Only merchants with at least this many products.",
                                "example": 10
                              },
                              "product_count_max": {
                                "type": "number",
                                "description": "Only merchants with at most this many products.",
                                "example": 10
                              },
                              "promotion_count_min": {
                                "type": "number",
                                "description": "Only merchants with at least this many promotions.",
                                "example": 10
                              },
                              "promotion_count_max": {
                                "type": "number",
                                "description": "Only merchants with at most this many promotions.",
                                "example": 10
                              },
                              "has_commissionable_url": {
                                "type": "number",
                                "description": "`1` keeps only merchants with a stored commissionable URL template. Not a test for linkability: read providers[].template instead.",
                                "example": 1,
                                "enum": [1]
                              },
                              "per_page": {
                                "type": "number",
                                "description": "Merchants per page, 1 to 50. Defaults to 10 here; merchant records are large.",
                                "example": 10
                              },
                              "page": {
                                "type": "number",
                                "description": "Page number, starting at 1.",
                                "example": 10
                              },
                              "fields": {
                                "type": "string",
                                "description": "Comma-separated field names to keep in each record, for example `id,name,logo_url`. Omit for every field.",
                                "example": "id,name,logo_url"
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
