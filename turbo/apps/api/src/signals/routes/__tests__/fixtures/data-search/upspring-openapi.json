  "x-firecrawl-capabilities": [
    {
      "key": "ads/search",
      "billing": {
        "unitLabel": "non-empty page",
        "maxCredits": 50
      },
      "credits_per_unit": 50
    }
  ],
  "paths": {
    "/v2/scrape": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["alexandria"],
                "properties": {
                  "alexandria": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": ["provider", "capability", "options"],
                        "properties": {
                          "provider": {
                            "type": "string",
                            "const": "upspring"
                          },
                          "capability": {
                            "type": "string",
                            "const": "ads/search"
                          },
                          "options": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "q": {
                                "type": "string",
                                "description": "Free-text brief, for example prebiotic soda or greens powder daily drink. Hybrid semantic and keyword match.",
                                "example": "<q>"
                              },
                              "vertical": {
                                "type": "array",
                                "description": "Vertical id(s), for example beverages or skincare. Ids come from taxonomy/verticals.",
                                "example": [],
                                "items": {
                                  "type": "string"
                                }
                              },
                              "category": {
                                "type": "string",
                                "description": "One category id within a vertical, from taxonomy/verticals.",
                                "example": "<category>"
                              },
                              "advertiser_id": {
                                "type": "array",
                                "description": "Only ads from these advertiser ids.",
                                "example": [],
                                "items": {
                                  "type": "string"
                                }
                              },
                              "is_active": {
                                "type": "string",
                                "description": "true for ads running now, false for stopped ones. Omit for both.",
                                "example": "true",
                                "enum": ["true", "false"]
                              },
                              "recency_days": {
                                "type": "number",
                                "description": "Only ads first seen in the last N days (1 to 365).",
                                "example": 10
                              },
                              "has_product": {
                                "type": "string",
                                "description": "true for ads whose landing page has store data (price, vendor), false for ads without. Omit for both.",
                                "example": "true",
                                "enum": ["true", "false"]
                              },
                              "min_impressions": {
                                "type": "number",
                                "description": "Winners-only floor on Meta's 1 to 5 delivery-strength indicator. Excludes ads without one.",
                                "example": 5
                              },
                              "media_type": {
                                "type": "array",
                                "description": "Only ads with this media type id (OR across values). Ids from taxonomy/vertical's dimensions.",
                                "example": [],
                                "items": {
                                  "type": "string"
                                }
                              },
                              "hook_archetype": {
                                "type": "array",
                                "description": "Only ads with this hook archetype id (OR across values). Ids from taxonomy/vertical's dimensions.",
                                "example": [],
                                "items": {
                                  "type": "string"
                                }
                              },
                              "hook_polarity": {
                                "type": "array",
                                "description": "Only ads with this hook polarity id (OR across values). Ids from taxonomy/vertical's dimensions.",
                                "example": [],
                                "items": {
                                  "type": "string"
                                }
                              },
                              "funnel": {
                                "type": "array",
                                "description": "Only ads with this funnel id (OR across values). Ids from taxonomy/vertical's dimensions.",
                                "example": [],
                                "items": {
                                  "type": "string"
                                }
                              },
                              "persona": {
                                "type": "array",
                                "description": "Only ads with this persona id (OR across values). Ids from taxonomy/vertical's dimensions.",
                                "example": [],
                                "items": {
                                  "type": "string"
                                }
                              },
                              "archetype": {
                                "type": "array",
                                "description": "Only ads with this archetype id (OR across values). Ids from taxonomy/vertical's dimensions.",
                                "example": [],
                                "items": {
                                  "type": "string"
                                }
                              },
                              "mechanism": {
                                "type": "array",
                                "description": "Only ads with this mechanism id (OR across values). Ids from taxonomy/vertical's dimensions.",
                                "example": [],
                                "items": {
                                  "type": "string"
                                }
                              },
                              "positioning": {
                                "type": "array",
                                "description": "Only ads with this positioning id (OR across values). Ids from taxonomy/vertical's dimensions.",
                                "example": [],
                                "items": {
                                  "type": "string"
                                }
                              },
                              "offer_type": {
                                "type": "array",
                                "description": "Only ads with this offer type id (OR across values). Ids from taxonomy/vertical's dimensions.",
                                "example": [],
                                "items": {
                                  "type": "string"
                                }
                              },
                              "persuasion_technique": {
                                "type": "array",
                                "description": "Only ads that use this persuasion technique (an ad can carry several). Ids from taxonomy/vertical's dimensions.",
                                "example": [],
                                "items": {
                                  "type": "string"
                                }
                              },
                              "claim_type": {
                                "type": "array",
                                "description": "Only ads that use this claim type (an ad can carry several). Ids from taxonomy/vertical's dimensions.",
                                "example": [],
                                "items": {
                                  "type": "string"
                                }
                              },
                              "evidence_type": {
                                "type": "array",
                                "description": "Only ads that use this evidence type (an ad can carry several). Ids from taxonomy/vertical's dimensions.",
                                "example": [],
                                "items": {
                                  "type": "string"
                                }
                              },
                              "limit": {
                                "type": "number",
                                "description": "Ads per page, 1 to 100 (1 to 50 with include=descriptors). Default 25.",
                                "example": 10
                              },
                              "include": {
                                "type": "string",
                                "description": "Comma-separated: descriptors adds synopsis and long_form narration per ad (token-heavy); media adds durable {video_url, image_url, thumbnail_url, width, height}.",
                                "example": "<include>"
                              },
                              "cursor": {
                                "type": "string",
                                "description": "meta.next_cursor from the previous page, verbatim. Send the same filters with it; a cursor replayed with changed filters is refused.",
                                "example": "<cursor>"
                              }
                            },
                            "required": ["q"]
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
