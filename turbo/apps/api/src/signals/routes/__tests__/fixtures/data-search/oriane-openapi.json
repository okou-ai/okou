  "x-firecrawl-credit-cost": {
    "min": 30,
    "max": 30
  },
  "x-firecrawl-capabilities": [
    {
      "key": "instagram/profiles-search",
      "billing": {
        "unitLabel": "nonempty call",
        "maxCredits": 40,
        "optionPrices": {
          "option": "projection",
          "default": "default",
          "prices": {
            "basic": 20,
            "default": 30,
            "full": 40
          }
        }
      },
      "credits_per_unit": 30
    }
  ],
  "paths": {
    "/v2/scrape": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["alexandria"],
                "properties": {
                  "alexandria": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": ["provider", "capability", "options"],
                        "properties": {
                          "provider": {
                            "type": "string",
                            "const": "oriane"
                          },
                          "capability": {
                            "type": "string",
                            "const": "instagram/profiles-search"
                          },
                          "options": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "handle": {
                                "type": "string",
                                "description": "Account username to match exactly, for example mrbeast. A leading @ is optional; usernames are matched without regard to case. Provide this or another search field; multiple fields must all match.",
                                "example": "<handle>"
                              },
                              "displayName": {
                                "type": "string",
                                "description": "Text to match in the display name. Provide this or another search field; multiple fields must all match.",
                                "example": "<displayName>"
                              },
                              "bio": {
                                "type": "string",
                                "description": "Text to match in the bio. Provide this or another search field; multiple fields must all match.",
                                "example": "<bio>"
                              },
                              "limit": {
                                "type": "number",
                                "description": "Maximum results, default 20.",
                                "example": 10
                              },
                              "offset": {
                                "type": "number",
                                "description": "Result offset, default 0. Exact handle searches return at most one profile and require offset 0; paginate displayName or bio searches instead.",
                                "example": 10
                              },
                              "sort": {
                                "type": "string",
                                "description": "Comma-separated sort fields with optional :asc or :desc. Profiles: followersCount, createdAt, updatedAt. Posts: viewsCount, likesCount, sharesCount, commentsCount, interactionsCount, engagementRatePerViews, engagementRatePerFollowers, profileFollowersCount, publishedAt, visualSimilarity, transcriptRelevance.",
                                "example": "<sort>"
                              },
                              "projection": {
                                "type": "string",
                                "description": "Response detail and fixed price per nonempty call: basic 20 credits, default 30 credits, full 40 credits. Empty results cost zero. Result limit does not change the tier price.",
                                "example": "default",
                                "enum": ["basic", "default", "full"]
                              }
                            },
                            "allOf": [
                              {
                                "anyOf": [
                                  {
                                    "required": ["handle"]
                                  },
                                  {
                                    "required": ["displayName"]
                                  },
                                  {
                                    "required": ["bio"]
                                  }
                                ]
                              }
                            ]
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
