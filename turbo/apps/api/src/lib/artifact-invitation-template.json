{
  "name": "Okou | File share invitation",
  "alias": "okou-artifact-invitation-v1",
  "subject": "You’re invited to view a file on Okou",
  "html": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n    <meta name=\"x-apple-disable-message-reformatting\">\n    <meta name=\"format-detection\" content=\"telephone=no,address=no,email=no,date=no,url=no\">\n    <meta name=\"color-scheme\" content=\"light\">\n    <meta name=\"supported-color-schemes\" content=\"light\">\n    <title>A file has been shared with you</title>\n    <style>\n      body { margin:0 !important;padding:0 !important;width:100% !important;background-color:#FFFFFF; }\n      table { border-collapse:collapse; }\n      img { -ms-interpolation-mode:bicubic; }\n      body,table,td,a { -webkit-text-size-adjust:100%;-ms-text-size-adjust:100%; }\n      table,td { mso-table-lspace:0;mso-table-rspace:0; }\n      #outlook a { padding:0; }\n      .ExternalClass { width:100%; }\n      .ExternalClass,.ExternalClass p,.ExternalClass td,.ExternalClass div { line-height:100%; }\n      @media only screen and (max-width:640px) {\n        .ok-shell { padding-left:20px !important;padding-right:20px !important; }\n        .ok-h1 { font-size:22px !important;line-height:30px !important; }\n        .container { width:100% !important;max-width:600px !important; }\n      }\n    </style>\n    <!--[if mso]><style>body,table,td,a {font-family:Arial,Helvetica,sans-serif !important;}</style><![endif]-->\n  </head>\n  <body style=\"margin:0;padding:0;background-color:#FFFFFF;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;color:#242121;font-size:14px;line-height:22px;\">\n    <div style=\"display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;mso-hide:all;\">{{{INVITER_NAME}}} invited you to view a file on Okou.</div>\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#FFFFFF\" style=\"width:100%;background-color:#FFFFFF;\">\n      <tr>\n        <td class=\"ok-shell\" align=\"center\" valign=\"top\" style=\"padding:24px 16px 48px;\">\n          <!--[if mso]><table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td><![endif]-->\n          <table role=\"presentation\" class=\"container\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:600px;text-align:left;\">\n            <tr>\n              <td style=\"padding:0 0 40px;\">\n                <img src=\"https://clever-flame-3d70727f81.media.strapiapp.com/okou_clerk_banner_new_o_20261022_517ff41914.png\" width=\"600\" height=\"225\" alt=\"Okou - get the right data, run agentic workflows, and deliver finished work with team-wide context.\" style=\"display:block;width:100%;max-width:600px;height:auto;border:0;outline:none;text-decoration:none;border-radius:18px;\">\n              </td>\n            </tr>\n            <tr>\n              <td style=\"font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;color:#242121;font-size:14px;line-height:22px;\">\n                <h1 class=\"ok-h1\" style=\"margin:0 0 20px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:26px;line-height:34px;color:#242121;font-weight:700;letter-spacing:-0.5px;\">A file has been shared with you</h1>\n                <p style=\"margin:0 0 20px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;color:#242121;font-size:14px;line-height:22px;\"><strong style=\"font-weight:600;\">{{{INVITER_NAME}}}</strong> invited you to view a file on Okou.</p>\n                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#FAF5F3\" style=\"width:100%;background-color:#FAF5F3;table-layout:fixed;\">\n                  <tr>\n                    <td style=\"padding:16px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;color:#242121;font-size:14px;line-height:22px;\">\n                      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;table-layout:fixed;\">\n                        <tr>\n                          <td width=\"100\" valign=\"top\" style=\"width:100px;padding:2px 12px 2px 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;color:#242121;font-size:14px;line-height:22px;color:#8C8685;\">Invited email:</td>\n                          <td valign=\"top\" style=\"padding:2px 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;color:#242121;font-size:14px;line-height:22px;font-weight:600;overflow-wrap:anywhere;word-break:break-word;\">{{{RECIPIENT_EMAIL}}}</td>\n                        </tr>\n                        <tr>\n                          <td width=\"100\" valign=\"top\" style=\"width:100px;padding:2px 12px 2px 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;color:#242121;font-size:14px;line-height:22px;color:#8C8685;\">Access:</td>\n                          <td valign=\"top\" style=\"padding:2px 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;color:#242121;font-size:14px;line-height:22px;font-weight:600;\">This file only</td>\n                        </tr>\n                      </table>\n                    </td>\n                  </tr>\n                </table>\n                <p style=\"margin:24px 0 0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;color:#242121;font-size:14px;line-height:22px;\">Sign in to Okou with the email address above to open the shared file. If you do not have an account yet, create one with this email address and verify it.</p>\n                <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"border-collapse:separate;margin:20px 0 16px;\">\n                  <tr>\n                    <td align=\"center\" valign=\"middle\" bgcolor=\"#3363D3\" style=\"background-color:#3363D3;border-radius:19px;mso-padding-alt:11px 40px;\">\n                      <a href=\"{{{ARTIFACT_URL}}}\" target=\"_blank\" style=\"display:inline-block;padding:11px 40px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;line-height:16px;font-weight:700;color:#FFFFFF;text-decoration:none;border-radius:19px;\">Open shared file</a>\n                    </td>\n                  </tr>\n                </table>\n                <p style=\"margin:0 0 20px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;color:#242121;font-size:14px;line-height:22px;\">If you are having trouble with the button, <a href=\"{{{ARTIFACT_URL}}}\" target=\"_blank\" style=\"font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;color:#242121;font-size:14px;line-height:22px;font-weight:600;text-decoration:none;border-bottom:2px solid #F9E840;\">click here</a>.</p>\n                <p style=\"margin:0 0 20px;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;color:#242121;font-size:14px;line-height:22px;\">This invitation only grants access to this file. It does not add you to a workspace.</p>\n                <p style=\"margin:0;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;color:#242121;font-size:14px;line-height:22px;\">If you have any questions or need any help, please reach out to <a href=\"mailto:support@okou.ai\" style=\"font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;color:#242121;font-size:14px;line-height:22px;font-weight:600;text-decoration:none;border-bottom:2px solid #F9E840;\">support@okou.ai</a>.</p>\n              </td>\n            </tr>\n            <tr>\n              <td style=\"padding:24px 0 0;\">\n                <p style=\"margin:0;padding:16px 0 0;border-top:1px solid #D8CBC4;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;line-height:18px;color:#8C8685;\">If you were not expecting this invitation, you can ignore this email.</p>\n              </td>\n            </tr>\n          </table>\n          <!--[if mso]></td></tr></table><![endif]-->\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>\n",
  "text": "A file has been shared with you\n\n{{{INVITER_NAME}}} invited you to view a file on Okou.\n\nSign in to Okou with {{{RECIPIENT_EMAIL}}} to open the shared file. If you do not have an account yet, create one with this email address and verify it.\n\nThis invitation only grants access to this file. It does not add you to a workspace.\n\nOpen shared file → [{{{ARTIFACT_URL}}}]\n\nIf you were not expecting this invitation, you can ignore this email. · Contact support [support@okou.ai]",
  "variables": [
    {
      "key": "INVITER_NAME",
      "type": "string"
    },
    {
      "key": "RECIPIENT_EMAIL",
      "type": "string"
    },
    {
      "key": "ARTIFACT_URL",
      "type": "string"
    }
  ],
  "from": "Okou <noreply@okou.ai>"
}
