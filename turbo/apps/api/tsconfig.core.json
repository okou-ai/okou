{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": false,
    "disableSourceOfProjectReferenceRedirect": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./.typecheck/core",
    "tsBuildInfoFile": "./.typecheck/core.tsbuildinfo"
  },
  "include": [
    "src/*.ts",
    "src/lib/**/*",
    "src/mocks/**/*",
    "src/types/**/*",
    "src/scripts/**/*",
    "src/signals/*.ts",
    "src/signals/auth/**/*",
    "src/signals/context/**/*",
    "src/signals/external/**/*",
    "src/signals/services/**/*",
    "src/**/*.json"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/__benches__/**/*",
    "src/**/__tests__/**/*",
    "src/**/*.bench.ts",
    "src/**/*.spec.ts",
    "src/**/*.suite.ts",
    "src/**/*.test.ts",
    "src/test-fixtures/**/*",
    "src/index.ts",
    "src/production-bootstrap.ts",
    "src/server.ts",
    "src/signals/route.ts",
    "src/lib/env.ts",
    "src/lib/log.ts",
    "src/lib/secret-kms-client.ts",
    "src/lib/singleton.ts",
    "src/signals/external/clerk.ts",
    "src/signals/external/mcp-server.ts",
    "src/signals/external/s3.ts",
    "src/signals/external/stripe-client.ts",
    "src/signals/external/slack-block-kit.ts",
    "src/signals/external/slack-message-client.ts",
    "src/signals/external/slack-oauth-client.ts",
    "src/signals/utils.ts",
    "src/signals/routes/**/*"
  ],
  "references": [{ "path": "./tsconfig.gateways.json" }]
}
