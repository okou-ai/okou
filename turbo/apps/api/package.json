{
  "name": "api",
  "version": "2.35.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:worker": "node scripts/build-worker.mjs",
    "test:worker-build": "node --test scripts/build-worker.node-test.mjs scripts/worker-contract-boundaries.node-test.mjs",
    "check-types:worker": "bash scripts/check-types.sh worker",
    "dev": "bash scripts/dev.sh",
    "env:validate": "tsx src/scripts/validate-env.ts",
    "start": "tsx src/server.ts",
    "db:dev-seed": "dotenv -e .env.local -- tsx src/scripts/dev-seed.ts",
    "db:dev-bench-seed": "dotenv -e .env.local -- tsx src/scripts/dev-bench-seed.ts",
    "discord:register": "node scripts/register-discord-commands.mjs",
    "test": "vitest run",
    "test:native-competing-claims": "node scripts/native-competing-claims.mjs",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings && GOMAXPROCS=1 oxlint src --type-aware -c ../../.oxlintrc.typeaware.json --ignore-pattern '**/__tests__/**' --deny-warnings && GOMAXPROCS=1 oxlint $(find src -type d -name __tests__) --type-aware -c ../../.oxlintrc.typeaware.json --deny-warnings && eslint . --max-warnings 0",
    "check-types": "bash scripts/check-types.sh",
    "check-types:deps": "bash scripts/check-types.sh deps",
    "check-types:boundaries": "bash scripts/check-types.sh boundaries",
    "check-types:gateways": "tsc -p tsconfig.gateways.json --checkers $(node ../../scripts/tsc-checkers.mjs)",
    "check-types:foundation": "bash scripts/check-types.sh foundation",
    "check-types:admission": "bash scripts/check-types.sh admission",
    "check-types:core": "bash scripts/check-types.sh core",
    "check-types:bootstrap": "bash scripts/check-types.sh bootstrap",
    "check-types:tests": "bash scripts/check-types.sh tests",
    "check-types:bootstrap-wiring": "bash scripts/check-types.sh bootstrap-wiring"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1159.0",
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "@axiomhq/js": "^2.0.0",
    "@axiomhq/logging": "^0.1.6",
    "@clerk/backend": "^3.13.1",
    "@hono/node-server": "^2.1.3",
    "@hono/otel": "^1.1.2",
    "@modelcontextprotocol/client": "^2.3.0",
    "@modelcontextprotocol/server": "^2.3.0",
    "@okouai/api-contracts": "workspace:*",
    "@okouai/browser-extension-client": "workspace:*",
    "@okouai/connectors": "workspace:*",
    "@okouai/core": "workspace:*",
    "@okouai/db": "workspace:*",
    "@okouai/pi-agent-runtime": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/cloudflare": "^10.76.2",
    "@sentry/node": "^10.73.0",
    "@slack/web-api": "^7.13.0",
    "@stripe/link-sdk": "^0.13.2",
    "@t3-oss/env-core": "^0.13.11",
    "@vercel/functions": "^3.4.4",
    "@vercel/oidc": "^3.2.1",
    "@vercel/otel": "^2.1.2",
    "ably": "^2.28.0",
    "archiver": "^8.0.0",
    "ccstate": "^6.1.0",
    "cfb": "^1.2.2",
    "croner": "^9.1.0",
    "drizzle-orm": "^0.45.2",
    "entities": "7.0.1",
    "fflate": "^0.8.3",
    "file-type": "^21.3.4",
    "fontkit": "2.0.4",
    "google-auth-library": "^10.9.0",
    "hash-wasm": "4.12.0",
    "hono": "^4.13.12",
    "html-to-text": "^10.0.1",
    "jose": "^6.2.3",
    "markdown-it": "14.3.3",
    "music-metadata": "^11.16.0",
    "pg": "^8.23.0",
    "resend": "^6.12.4",
    "saxes": "6.0.0",
    "signal-timers": "^1.0.4",
    "stripe": "^20.4.1",
    "svix": "^2.8.0",
    "tar": "^7.5.19",
    "uuid": "^14.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260924.1",
    "@electric-sql/pglite": "^0.5.13",
    "@hono/vite-build": "^1.11.1",
    "@okouai/eslint-config": "workspace:*",
    "@okouai/eslint-rules": "workspace:*",
    "@okouai/typescript-config": "workspace:*",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@types/archiver": "^8.0.0",
    "@types/fontkit": "2.0.9",
    "@types/html-to-text": "^9.0.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.21.0",
    "@types/web-push": "^3.6.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "adm-zip": "^0.6.1",
    "clerk": "^3.0.1",
    "eslint": "^9.34.0",
    "msw": "^2.13.2",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "^4.19.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.1.6",
    "vitest": "^5.0.5"
  }
}
