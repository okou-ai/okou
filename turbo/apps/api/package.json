{
  "name": "api",
  "version": "1.593.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "bash scripts/dev.sh",
    "start": "tsx src/server.ts",
    "db:dev-seed": "dotenv -e .env.local -- tsx src/scripts/dev-seed.ts",
    "db:dev-bench-seed": "dotenv -e .env.local -- tsx src/scripts/dev-bench-seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings && GOMAXPROCS=1 oxlint src --type-aware -c ../../.oxlintrc.typeaware.json --ignore-pattern '**/__tests__/**' --deny-warnings && GOMAXPROCS=1 oxlint $(find src -type d -name __tests__) --type-aware -c ../../.oxlintrc.typeaware.json --deny-warnings && eslint . --max-warnings 0",
    "check-types": "pnpm run check-types:deps && pnpm run check-types:boundaries && pnpm run check-types:gateways && pnpm run check-types:core && pnpm run check-types:bootstrap && pnpm run check-types:tests && pnpm run check-types:bootstrap-wiring",
    "check-types:deps": "pnpm --filter @okouai/pi-agent-runtime run build",
    "check-types:boundaries": "node scripts/check-typecheck-boundaries.mjs",
    "check-types:gateways": "tsc -p tsconfig.gateways.json --checkers $(node ../../scripts/tsc-checkers.mjs)",
    "check-types:core": "tsc -p tsconfig.core.json --checkers $(node ../../scripts/tsc-checkers.mjs)",
    "check-types:bootstrap": "tsc -p tsconfig.bootstrap.json --checkers $(node ../../scripts/tsc-checkers.mjs)",
    "check-types:tests": "tsc -p tsconfig.tests.json --noEmit --checkers $(node ../../scripts/tsc-checkers.mjs)",
    "check-types:bootstrap-wiring": "tsc -p tsconfig.bootstrap-wiring.json --noEmit --checkers $(node ../../scripts/tsc-checkers.mjs)"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1127.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@axiomhq/js": "^1.5.0",
    "@axiomhq/logging": "^0.1.6",
    "@clerk/backend": "^3.13.1",
    "@hono/node-server": "^2.0.10",
    "@hono/otel": "^1.1.2",
    "@modelcontextprotocol/client": "^2.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/node": "^10.73.0",
    "@slack/web-api": "^7.13.0",
    "@t3-oss/env-core": "^0.13.11",
    "@vercel/functions": "^3.4.4",
    "@vercel/oidc": "^3.2.1",
    "@vercel/otel": "^2.1.2",
    "@okouai/api-contracts": "workspace:*",
    "@okouai/connectors": "workspace:*",
    "@okouai/core": "workspace:*",
    "@okouai/db": "workspace:*",
    "@okouai/pi-agent-runtime": "workspace:*",
    "@zip.js/zip.js": "^2.14.1",
    "ably": "^2.21.0",
    "archiver": "^8.0.0",
    "ccstate": "^5.5.0",
    "croner": "^9.1.0",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^10.9.0",
    "gpt-tokenizer": "^3.4.0",
    "hono": "^4.13.0",
    "html-to-text": "^10.0.1",
    "ignore": "^7.0.5",
    "image-dimensions": "^2.5.1",
    "markdown-it": "14.2.0",
    "music-metadata": "^11.13.0",
    "pg": "^8.23.0",
    "resend": "^6.12.4",
    "signal-timers": "^1.0.4",
    "stripe": "^20.4.1",
    "svix": "^2.3.0",
    "tar": "^7.5.19",
    "uuid": "^14.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@hono/node-server-v1": "npm:@hono/node-server@1.19.14",
    "@hono/vite-build": "^1.11.1",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@types/archiver": "^8.0.0",
    "@types/html-to-text": "^9.0.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.21.0",
    "@types/web-push": "^3.6.4",
    "@okouai/eslint-config": "workspace:*",
    "@okouai/eslint-rules": "workspace:*",
    "@okouai/typescript-config": "workspace:*",
    "adm-zip": "^0.6.0",
    "clerk": "^3.0.1",
    "eslint": "^9.34.0",
    "msw": "^2.13.2",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "^4.19.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.0.16",
    "vitest": "^5.0.0"
  }
}
