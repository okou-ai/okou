{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "okou-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  // Phase-one previews read hashed app assets through the existing public
  // static.okou.io R2 origin. The Worker source also supports a native
  // STATIC_ASSETS_BUCKET binding once a dedicated deploy token is provisioned.
  "env": {
    "preview": {
      "main": "src/preview.ts",
      "name": "okou-app-preview",
      "workers_dev": true,
      "preview_urls": true,
    },
    "production": {
      "name": "okou-app-production",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "app.okou.ai/*",
          "zone_name": "okou.ai",
        },
      ],
    },
  },
}
