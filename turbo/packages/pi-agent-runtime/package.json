{
  "name": "@okouai/pi-agent-runtime",
  "version": "1.29.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./src/api.ts"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./src/node.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint && oxlint --type-aware -c ../../.oxlintrc.typeaware.json && eslint . --max-warnings 0",
    "build": "tsc -p tsconfig.build.json && pnpm run check-public-declarations",
    "check-public-declarations": "node scripts/check-public-declarations.mjs",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@okouai/api-contracts": "workspace:*",
    "@okouai/connectors": "workspace:*",
    "@smithy/node-http-handler": "4.7.3",
    "gpt-tokenizer": "^3.4.0",
    "http-proxy-agent": "7.0.2",
    "https-proxy-agent": "7.0.6",
    "undici": "7.29.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@okouai/eslint-config": "workspace:*",
    "@okouai/typescript-config": "workspace:*",
    "@types/node": "^24.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^9.34.0",
    "msw": "^2.13.2",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.0.0"
  }
}
