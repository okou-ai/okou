{
  "name": "@okouai/db",
  "version": "1.323.7",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./runtime/*": {
      "import": "./src/runtime/*.ts",
      "types": "./src/runtime/*.ts"
    },
    "./schema/*": {
      "import": "./src/schema/*.ts",
      "types": "./src/schema/*.ts"
    },
    "./jsonb-contracts/*": {
      "import": "./src/jsonb-contracts/*.ts",
      "types": "./src/jsonb-contracts/*.ts"
    },
    "./operations/org-metadata-canonical-write": {
      "import": "./src/operations/org-metadata-canonical-write.ts",
      "types": "./src/operations/org-metadata-canonical-write.ts"
    },
    "./types": {
      "import": "./src/types.ts",
      "types": "./src/types.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm lint:jsonb-contracts && oxlint && oxlint --type-aware -c ../../.oxlintrc.typeaware.json && eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "tsx scripts/reset-db.ts",
    "test:migration-consistency": "pnpm test:connector-catalog-entry-columns && pnpm test:unselectable-thread-model-cleanup && pnpm test:file-run-provenance && pnpm test:file-thread-associations && pnpm test:legacy-free-retirement && pnpm test:pi-memory-stage1-alerts && pnpm test:migration-runner && pnpm test:kms-rotation && pnpm test:pi-memory-checkpoint-settlement && pnpm test:pi-memory-citations && pnpm test:show-usage-pack-migration && pnpm test:plan-entitlement-capability-migration && pnpm test:reusable-ssh-credentials && pnpm test:cloudflare-access && pnpm test:vnc-configuration && pnpm test:vnc-runner-authority && pnpm test:agent-grant-table-retirement && pnpm test:morning-brief-enrollment-installation && pnpm test:pi-candidate-trigger-retirement && pnpm test:historical-blob-audit && pnpm test:hosted-publication-history-audit && pnpm test:hosted-publication-runtime && pnpm test:hosted-publication-contraction && pnpm test:hosted-publication-pointers && pnpm test:private-artifact-absolute-urls && pnpm test:pro-suspend-retirement && pnpm test:slack-ingress-failed-retirement && pnpm test:prepared-domain-trigger-retirement && pnpm test:pi-inference-lifecycle && pnpm test:retire-v7-chat-event-snapshots && pnpm --filter api test:chat-event-sequences && pnpm --filter api test:chat-event-context && pnpm --filter api test:chat-event-auxiliary && tsx scripts/test-migration-consistency-schema.ts",
    "test:vnc-configuration": "tsx scripts/test-vnc-configuration.ts",
    "test:agent-grant-table-retirement": "tsx scripts/test-agent-grant-table-retirement.ts",
    "test:vnc-runner-authority": "tsx scripts/test-vnc-runner-authority.ts",
    "test:cloudflare-access": "tsx scripts/test-cloudflare-access.ts",
    "test:kms-rotation": "tsx scripts/migrations/013-kms-account-rotation/test.ts && tsx scripts/migrations/013-kms-account-rotation/test-business.ts",
    "test:show-usage-pack-migration": "tsx scripts/test-show-usage-pack-migration.ts",
    "test:plan-entitlement-capability-migration": "tsx scripts/test-plan-entitlement-capability-migration.ts",
    "test:migration-runner": "tsx scripts/test-migration-runner-timeouts.ts",
    "lint:jsonb-contracts": "tsx scripts/check-jsonb-contracts.ts",
    "test:pi-memory-checkpoint-settlement": "tsx scripts/test-pi-memory-checkpoint-settlement.ts",
    "test:pi-memory-citations": "tsx scripts/test-pi-memory-citation-migration.ts",
    "test:reusable-ssh-credentials": "tsx scripts/test-reusable-ssh-credentials.ts",
    "test:morning-brief-enrollment-installation": "tsx scripts/test-morning-brief-enrollment-installation.ts",
    "billing:attribution": "tsx scripts/billing-attribution.ts",
    "test:pi-candidate-trigger-retirement": "tsx scripts/test-pi-candidate-trigger-retirement.ts",
    "test:historical-blob-audit": "tsx scripts/test-historical-session-blob-audit.ts",
    "test:pi-inference-lifecycle": "tsx scripts/test-pi-inference-lifecycle.ts",
    "test:retire-v7-chat-event-snapshots": "tsx scripts/test-retire-v7-chat-event-snapshots.ts",
    "test:prepared-domain-trigger-retirement": "tsx scripts/test-prepared-domain-trigger-retirement.ts",
    "billing:pi-memory-stage1": "tsx scripts/pi-memory-stage1-cost.ts",
    "test:pi-memory-stage1-cost": "tsx scripts/test-pi-memory-stage1-cost.ts",
    "test:pi-memory-stage1-alerts": "node --test ../../../ops/pi-memory-stage1/v1/fixtures.test.mjs",
    "test:hosted-publication-history-audit": "tsx scripts/test-hosted-publication-history-audit.ts",
    "test:private-artifact-absolute-urls": "tsx scripts/test-private-artifact-absolute-urls.ts",
    "test:hosted-publication-runtime": "tsx scripts/test-hosted-publication-runtime.ts",
    "test:hosted-publication-contraction": "tsx scripts/test-hosted-publication-contraction.ts",
    "test:pro-suspend-retirement": "tsx scripts/test-pro-suspend-retirement.ts",
    "test:legacy-free-retirement": "tsx scripts/test-legacy-free-retirement.ts",
    "test:unselectable-thread-model-cleanup": "tsx scripts/test-unselectable-thread-model-cleanup.ts",
    "test:file-thread-associations": "tsx scripts/test-file-thread-associations.ts",
    "test:file-run-provenance": "tsx scripts/test-file-run-provenance.ts",
    "test:slack-ingress-failed-retirement": "tsx scripts/test-slack-ingress-failed-status-retirement.ts",
    "test:hosted-publication-pointers": "tsx scripts/migrations/018-hosted-publication-pointers/test.ts",
    "test:connector-catalog-entry-columns": "tsx scripts/test-connector-catalog-entry-columns.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1136.0",
    "@aws-sdk/client-s3": "^3.1136.0",
    "@clerk/backend": "^3.13.1",
    "@okouai/api-contracts": "workspace:*",
    "@okouai/connectors": "workspace:*",
    "@okouai/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.21.0",
    "@okouai/eslint-config": "workspace:*",
    "@okouai/eslint-rules": "workspace:*",
    "@okouai/typescript-config": "workspace:*",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.34.0",
    "msw": "^2.13.2",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "pg": "^8.23.0",
    "tsx": "^4.21.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.0.1",
    "zod": "^4.5.4"
  }
}
