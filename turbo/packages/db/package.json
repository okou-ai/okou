{
  "name": "@okouai/db",
  "version": "2.13.10",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./runtime/*": {
      "import": "./src/runtime/*.ts",
      "types": "./src/runtime/*.ts"
    },
    "./schema/*": {
      "import": "./src/schema/*.ts",
      "types": "./src/schema/*.ts"
    },
    "./jsonb-contracts/*": {
      "import": "./src/jsonb-contracts/*.ts",
      "types": "./src/jsonb-contracts/*.ts"
    },
    "./operations/org-metadata-canonical-write": {
      "import": "./src/operations/org-metadata-canonical-write.ts",
      "types": "./src/operations/org-metadata-canonical-write.ts"
    },
    "./operations/usage-pack-overdraft-transfer": {
      "import": "./src/operations/usage-pack-overdraft-transfer.ts",
      "types": "./src/operations/usage-pack-overdraft-transfer.ts"
    },
    "./types": {
      "import": "./src/types.ts",
      "types": "./src/types.ts"
    },
    "./operations/banking-connect-session-replacement": {
      "import": "./src/operations/banking-connect-session-replacement.ts",
      "types": "./src/operations/banking-connect-session-replacement.ts"
    },
    "./operations/run-history-deletion": {
      "import": "./src/operations/run-history-deletion.ts",
      "types": "./src/operations/run-history-deletion.ts"
    },
    "./operations/native-thread-binding": {
      "import": "./src/operations/native-thread-binding.ts",
      "types": "./src/operations/native-thread-binding.ts"
    },
    "./operations/billing-run-lifecycle": {
      "import": "./src/operations/billing-run-lifecycle.ts",
      "types": "./src/operations/billing-run-lifecycle.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm lint:jsonb-contracts && oxlint && oxlint --type-aware -c ../../.oxlintrc.typeaware.json && eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:smoke": "tsx scripts/migrate-smoke.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "tsx scripts/reset-db.ts",
    "test:migration-consistency": "tsx scripts/test-migration-consistency-schema.ts",
    "test:migration-runner": "tsx scripts/test-migration-runner-timeouts.ts",
    "test:presentation-template-copy": "node --import tsx scripts/migrations/025-presentation-template-copy/test-copy.ts",
    "lint:jsonb-contracts": "tsx scripts/check-jsonb-contracts.ts",
    "billing:attribution": "tsx scripts/billing-attribution.ts",
    "billing:pi-memory-stage1": "tsx scripts/pi-memory-stage1-cost.ts",
    "test:pi-memory-stage1-cost": "tsx scripts/test-pi-memory-stage1-cost.ts",
    "test:migration-smoke-diagnostics": "tsx scripts/test-migration-smoke-diagnostics.ts",
    "test:thread-predecessor-backfill": "tsx scripts/test-thread-predecessor-backfill.ts",
    "test:web-upload-artifact-threads": "tsx scripts/test-web-upload-artifact-threads.ts",
    "test:pi-memory-retirement": "tsx scripts/test-pi-memory-retirement.ts",
    "test:run-output-memory-citation-retirement": "tsx scripts/test-run-output-memory-citation-retirement.ts",
    "test:workflow-attachments": "node --import tsx scripts/migrations/024-workflow-attachments/test-backfill.ts",
    "test:content-bundles": "node --import tsx scripts/migrations/027-content-bundles/test-backfill.ts",
    "test:workflow-storage-retirement": "node --import tsx scripts/migrations/026-retire-workflow-storage/test-cleanup.ts"
  },
  "dependencies": {
    "@okouai/api-contracts": "workspace:*",
    "@okouai/connectors": "workspace:*",
    "@okouai/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@okouai/eslint-config": "workspace:*",
    "@okouai/eslint-rules": "workspace:*",
    "@okouai/typescript-config": "workspace:*",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.21.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.34.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "pg": "^8.23.0",
    "tar": "^7.5.19",
    "tsx": "^4.21.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.0.5",
    "zod": "^4.5.4"
  }
}
