{
  "name": "@okouai/core",
  "version": "8.805.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./*": {
      "import": "./src/*.ts",
      "types": "./src/*.ts"
    },
    "./contracts": {
      "import": "./src/contracts/index.ts",
      "types": "./src/contracts/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint && oxlint --type-aware -c ../../.oxlintrc.typeaware.json && eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@okouai/eslint-config": "workspace:*",
    "@okouai/eslint-rules": "workspace:*",
    "@okouai/typescript-config": "workspace:*",
    "@types/node": "^24.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^9.34.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@okouai/api-contracts": "workspace:*",
    "entities": "7.0.1",
    "fflate": "^0.8.3",
    "fractional-indexing": "^3.4.0",
    "htmlparser2": "^10.1.0",
    "tar": "^7.5.19",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  }
}
