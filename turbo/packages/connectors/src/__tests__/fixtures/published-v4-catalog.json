          "access": {
            "envBindings": {
              "SMS019_API_TOKEN": "$secrets.SMS019_API_TOKEN",
              "SMS019_USERNAME": "$vars.SMS019_USERNAME"
            },
            "kind": "static"
          },
          "description": "1. Sign in to the [019sms account](https://019sms.co.il/)\n2. Open **Settings / הגדרות > API Token Management / ניהול Token API** and create your first API token\n3. Copy the account username from the registration email or account settings\n4. Paste the account username and the token here; the token is shown only once, so store it securely\n\n019sms sends the token as an `Authorization: Bearer` header and requires\nthe account username inside each API request. The token inherits the\naccount's 019sms permissions. Regenerate it in 019sms if it is exposed or\nno longer trusted. Provider messaging charges and account limits remain\nyour responsibility.\n\nSee the [official API token guide](https://docs.019sms.co.il/guide/)\nand [SMS API documentation](https://docs.019sms.co.il/sms/) for current\nsetup and request details.",
          "grant": {
            "fields": [
              {
                "label": "API Token",
                "placeholder": "paste-your-019sms-api-token",
                "privateName": "SMS019_API_TOKEN",
                "publicId": "apiToken",
                "required": true,
                "storage": "secret"
              },
              {
                "label": "Account Username",
                "placeholder": "your-019sms-account-username",
                "privateName": "SMS019_USERNAME",
                "publicId": "accountUsername",
                "required": true,
                "storage": "variable"
              }
            ],
            "kind": "manual"
          },
          "id": "api-token",
          "label": "API Token and Account Username",
          "revoke": {
            "kind": "none"
          },
          "storage": {
            "secrets": ["SMS019_API_TOKEN"],
            "variables": ["SMS019_USERNAME"],
            "version": 1
          },
          "visible": true
        }
      ],
