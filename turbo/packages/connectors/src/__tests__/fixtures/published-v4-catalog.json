                    "GET /api/v2.0/news/app_news/{appNewsId}",
                    "GET /api/v2.0/news_tab_config",
                    "GET /api/v2.0/notifications",
                    "GET /api/v2.0/now",
                    "GET /api/v2.0/point_goods_shelves",
                    "GET /api/v2.0/search_shelves",
                    "GET /api/v2.0/search_shelves/{shelfId}",
                    "GET /api/v2.0/shelves/summary",
                    "POST /api/v2.0/product_details",
                    "POST /api/v2.0/products/-/images:batch_get",
                    "POST /api/v2.0/products/-/meta:batch_get",
                    "GET /api/v2.0/products:search"
                  ]
                },
                {
                  "description": "Read Nintendo Store app account age, family, points, rights, and notification settings",
                  "name": "nintendo-store-account-read",
                  "rules": [
                    "GET /api/v2.0/users/me/age",
                    "GET /api/v2.0/users/me/family/children",
                    "GET /api/v2.0/users/me/points",
                    "GET /api/v2.0/users/me/push_notification_config",
                    "GET /api/v2.0/users/me/rights",
                    "GET /api/v2.0/users/{naid}/qrcode_param"
