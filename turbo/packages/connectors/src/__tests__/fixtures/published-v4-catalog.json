      "firewall": {
        "billable": false,
        "categories": null,
        "config": {
          "apis": [
            {
              "auth": {
                "headers": {
                  "Authorization": "Bearer ${{ secrets.NINTENDO_STORE_TOKEN }}",
                  "User-Agent": "com.nintendo.znej/1.13.0 (Android/7.1.2)"
                }
              },
              "base": "https://api.accounts.nintendo.com",
              "permissions": [
                {
                  "description": "Read Nintendo Account profile for the connected account",
                  "name": "nintendo-account-profile-read",
                  "rules": ["GET /2.0.0/users/me"]
                }
              ]
            },
            {
              "auth": {
                "headers": {
                  "Authorization": "Bearer ${{ secrets.NINTENDO_STORE_TOKEN }}",
