                  "gentry-locale": "${{ vars.NINTENDO_STORE_LOCALE }}"
                }
              },
              "base": "https://app-api.znej.nintendo.com",
              "permissions": [
                {
                  "description": "Read Nintendo Store app public catalog, search, shelves, news, and product metadata",
                  "name": "nintendo-store-catalog-read",
                  "rules": [
                    "GET /api/v2.0/check_in_events",
                    "GET /api/v2.0/check_in_events/{eventId}/check_in_points",
