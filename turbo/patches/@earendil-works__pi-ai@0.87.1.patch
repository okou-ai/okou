+import { normalizeProviderError } from "./error-body.js";
+
+/** Only call for a failed provider request or assistant result. */
+export function isProviderQueueTimeout(error) {
+    const normalized = typeof error === "string" ? { message: error } : normalizeProviderError(error);
+    let message = (normalized.body ?? normalized.message).trim()
+        .replace(/^[A-Za-z0-9 ._-]{1,40} API error \(\d{3}\):\s*/i, "")
+        .replace(/^Codex error: /i, "")
+        .replace(/^\d{3}(?::| )\s*/, "");
+    if (message.startsWith("{")) {
+        try {
+            const body = JSON.parse(message);
+            const detail = body.error && typeof body.error === "object" ? body.error : body;
+            const code = typeof detail.code === "string" ? detail.code : detail.type;
+            // Specific provider failures keep their native policy even when
+            // accompanied by contradictory generic queue text.
+            if (detail.error === "insufficient_credits" || detail.code === 402 ||
+                [detail.code, detail.type].some((token) => typeof token === "string" &&
+                    /^(?:billing|billing_error|insufficient_quota|payment_required|billing_hard_limit_reached|insufficient_credits)$/i.test(token)) ||
+                (typeof code === "string" && /^(?:invalid_api_key|authentication_error|context_length_exceeded|context_window_exceeded|prompt_too_long|rate_limit_exceeded|rate_limit_error|usage_limit_reached|usage_not_included|content_policy_violation|model_not_found|unsupported_model|TOKEN_REFRESH_FAILED)$/.test(code)))
+                return false;
+            message = detail.message;
+        }
+        catch {
+            return false;
+        }
+    }
+    return typeof message === "string" && message.trim()
+        .replace(/^Codex error: /i, "")
+        .replace(/^(?:Error Code )?(?:unknown|server_error|internal_server_error|overloaded_error|server_overloaded|timeout): /i, "")
+        .toLowerCase() ===
+        "we were unable to start processing your request within the 900-second timeout limit. please try again later.";
+}
