  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!**/__tests__/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!**/*.spec.tsx",
        "!**/vitest.config.ts",
        "!**/src/test/**"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".vercel/output/**",
        "dist/**",
        "src/dist/**",
        ".source/**"
      ]
    },
    "@okouai/app#build": {
      "dependsOn": ["^build"],
      "env": ["OKOU_APP_GIT_COMMIT_SHA", "OKOU_APP_VERSION"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!**/__tests__/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!**/*.spec.tsx",
        "!**/vitest.config.ts",
        "!**/src/test/**"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".vercel/output/**",
        "dist/**",
        "src/dist/**",
        ".source/**"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint-runtime-api-compat": {
      "cache": false,
      "outputs": []
    },
    "check-types": {
      "dependsOn": ["^check-types", "^build"],
      "env": ["TSC_CHECKERS"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
